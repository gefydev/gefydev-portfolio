---
import SEO from "../components/SEO.astro";
import Navbar from "../components/Navbar.astro";
import HeroStage from "../components/HeroStage.astro";
import Footer from "../components/Footer.astro";
import TerminalModal from "../components/TerminalModal.astro";
import ImageModal from "../components/ImageModal.astro";
import { translations } from "../data/translations";
import "../styles/global.css";

interface Props {
    lang?: "es" | "en";
    title?: string;
    description?: string;
    keywords?: string;
    noindex?: boolean;
}

const lang = Astro.props.lang || Astro.locals.lang || "es";
const t = translations[lang];

const title = Astro.props.title || t.meta.title;
const description = Astro.props.description || t.meta.description;
const keywords = Astro.props.keywords || t.meta.keywords;
const noindex = Astro.props.noindex || false;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

        <!-- Preload Main Variable Font for Instant 0-shift FCP -->
        <link
            rel="preload"
            href="/fonts/geist-latin-wght-normal.woff2"
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />

        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/images/favicon-32.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="192x192"
            href="/images/favicon-192.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="512x512"
            href="/images/favicon-512.png"
        />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/images/apple-touch-icon.png"
        />

        <SEO
            title={title}
            description={description}
            keywords={keywords}
            lang={lang}
            noindex={noindex}
        />

        <!-- Speculation Rules API for instant 0ms cross-language navigation without heavy JS router -->
        <script type="speculationrules" is:inline>
            {
                "prerender": [
                    {
                        "where": { "href_matches": "/*" },
                        "eagerness": "moderate"
                    }
                ]
            }
        </script>
    </head>
    <body class="bg-bg text-fg antialiased min-h-screen flex flex-col justify-between">
        <div class="vida" aria-hidden="true"><div class="vida-spot"><div></div></div></div>
        <a href="#main-content" class="skip">
            {
                lang === "es"
                    ? "Saltar al contenido principal"
                    : "Skip to main content"
            }
        </a>

        <div class="top">
            <Navbar lang={lang} />
            <HeroStage lang={lang} />
        </div>

        <main id="main-content" class="flex-1">
            <slot />
        </main>

        <Footer lang={lang} />
        <TerminalModal lang={lang} />
        <ImageModal lang={lang} />
        <script is:inline>
            /* VIDA: linterna que sigue al mouse. Solo pointer fine, sin reduced-motion. Solo transform. */
            (function () {
                var s = document.querySelector(".vida-spot"), d = document.documentElement;
                if (!s || !matchMedia("(hover: hover) and (pointer: fine)").matches) return;
                var rm = matchMedia("(prefers-reduced-motion: reduce)");
                if (rm.matches) return;
                var g = s.firstElementChild, R = s.offsetWidth / 2, tx = 0, ty = 0, x = 0, y = 0, raf = 0, first = true, a = 0, b = 0;
                function place() {
                    // la grilla base viaja con la página: la iluminada (capa fija) se corre el resto del scroll sobre la celda
                    s.style.transform = "translate3d(" + a + "px," + b + "px,0)";
                    g.style.transform = "translate3d(" + -a + "px," + (-b - (scrollY % 32)) + "px,0)";
                }
                function tick() {
                    x += (tx - x) * 0.18; y += (ty - y) * 0.18;
                    a = Math.round(x - R); b = Math.round(y - R);
                    place();
                    raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(tick) : 0;
                }
                addEventListener("scroll", function () { if (!first) place(); }, { passive: true });
                addEventListener("pointermove", function (e) {
                    if (e.pointerType !== "mouse" || rm.matches) return;
                    tx = e.clientX; ty = e.clientY;
                    if (first) { x = tx; y = ty; first = false; }
                    d.setAttribute("data-vida", "");
                    if (!raf) raf = requestAnimationFrame(tick);
                }, { passive: true });
                document.addEventListener("pointerout", function (e) { if (!e.relatedTarget) d.removeAttribute("data-vida"); });
            })();
        </script>
        <script is:inline>
            /* GRILLA: sin calc-size (Firefox, Safari) se completa con padding la altura de cada bloque a un múltiplo de 32 px. */
            (function () {
                if (window.CSS && CSS.supports("height", "calc-size(auto, size)")) return;
                var els = document.querySelectorAll(".hero, .section");
                function round(el) {
                    var extra = parseFloat(el.dataset.gridExtra || "0"), base = el.getBoundingClientRect().height - extra;
                    var next = (32 - (base % 32)) % 32;
                    if (next > 31.5) next = 0;
                    if (Math.abs(next - extra) < 0.25) return;
                    el.style.paddingBottom = "";
                    var pad = parseFloat(getComputedStyle(el).paddingBottom);
                    el.style.paddingBottom = pad + next + "px";
                    el.dataset.gridExtra = String(next);
                }
                els.forEach(round);
                if (window.ResizeObserver) {
                    var ro = new ResizeObserver(function (list) { requestAnimationFrame(function () { list.forEach(function (e) { round(e.target); }); }); });
                    els.forEach(function (el) { ro.observe(el); });
                }
                addEventListener("load", function () { els.forEach(round); });
            })();
        </script>
    </body>
</html>
