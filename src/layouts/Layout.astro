---
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import TerminalModal from '../components/TerminalModal.astro';
import { translations } from '../data/translations';
import '../styles/global.css';

interface Props {
  lang?: 'es' | 'en';
  title?: string;
  description?: string;
  keywords?: string;
  noindex?: boolean;
}

const lang = Astro.props.lang || Astro.locals.lang || 'es';
const t = translations[lang];

const title = Astro.props.title || t.meta.title;
const description = Astro.props.description || t.meta.description;
const keywords = Astro.props.keywords || t.meta.keywords;
const noindex = Astro.props.noindex || false;
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preload" href="/logo-white-bg.webp" as="image" type="image/webp" fetchpriority="high" />
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      lang={lang}
      noindex={noindex}
    />
    <ClientRouter />
  </head>
  <body class="bg-[#06070b] text-zinc-100 antialiased selection:bg-[#735ed5]/30 selection:text-white min-h-screen flex flex-col justify-between">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#0db7b9] focus:text-zinc-950 focus:font-sans focus:font-bold focus:rounded-md focus:shadow-xl"
    >
      {lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>

    <Navbar lang={lang} />

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer lang={lang} />
    <TerminalModal lang={lang} />
  </body>
</html>
