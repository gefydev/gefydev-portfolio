---
import { translations } from '../data/translations';
import { Briefcase, Calendar, MapPin, ExternalLink, Sparkles } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

interface ExperienceItem {
  company: string;
  role: {
    es: string;
    en: string;
  };
  period: string;
  location: string;
  description: {
    es: string[];
    en: string[];
  };
  tech: string[];
  website?: string;
  current?: boolean;
}

const experiences: ExperienceItem[] = [];
---

<section id="experience" class="py-24 border-t border-zinc-800/80 relative" aria-labelledby="experience-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-mono text-amber-400">
        <Briefcase class="w-3.5 h-3.5" />
        <span>04 // {lang === 'es' ? 'EXPERIENCIA' : 'EXPERIENCE'}</span>
      </div>
      <h2 id="experience-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
        {t.experience.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base font-sans max-w-xl">
        {t.experience.sectionSubtitle}
      </p>
    </div>

    {experiences.length > 0 ? (
      <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-zinc-800">
        {experiences.map((exp) => (
          <div class="relative pl-10 group">
            <div class="absolute left-2 top-1.5 w-3.5 h-3.5 rounded-full bg-sky-500 border-4 border-zinc-950 group-hover:scale-125 transition-transform"></div>
            
            <div class="rounded-xl bg-zinc-950/80 border border-zinc-800 p-6 space-y-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <h3 class="text-lg font-bold text-white font-sans">{exp.role[lang]}</h3>
                  <div class="flex items-center gap-2 font-mono text-xs text-sky-400">
                    <span>{exp.company}</span>
                    {exp.website && (
                      <a href={exp.website} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-sky-300">
                        <ExternalLink class="w-3 h-3 inline" />
                      </a>
                    )}
                  </div>
                </div>

                <div class="flex items-center gap-3 font-mono text-xs text-zinc-400">
                  <span class="flex items-center gap-1">
                    <Calendar class="w-3.5 h-3.5 text-zinc-500" />
                    <span>{exp.period}</span>
                  </span>
                  <span class="flex items-center gap-1">
                    <MapPin class="w-3.5 h-3.5 text-zinc-500" />
                    <span>{exp.location}</span>
                  </span>
                </div>
              </div>

              <ul class="space-y-2 text-xs sm:text-sm text-zinc-400 list-disc list-inside">
                {exp.description[lang].map((point) => (
                  <li>{point}</li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-1.5 pt-2">
                {exp.tech.map((item) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-zinc-900 text-zinc-400 border border-zinc-800">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="rounded-xl bg-zinc-950/60 border border-zinc-800/80 p-8 text-center space-y-4 max-w-2xl mx-auto">
        <div class="w-12 h-12 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center mx-auto">
          <Sparkles class="w-5 h-5" />
        </div>
        <h3 class="text-lg font-bold text-white font-sans">{t.experience.emptyTitle}</h3>
        <p class="text-xs sm:text-sm text-zinc-400 font-sans leading-relaxed">
          {t.experience.emptyDesc}
        </p>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{t.experience.openToWorkBadge}</span>
        </div>
      </div>
    )}
  </div>
</section>
