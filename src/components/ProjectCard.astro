---
import type { Project } from "../data/projects";

interface Props {
    project: Project;
    lang: "es" | "en";
}

const { project, lang } = Astro.props;
const liveDemoAria =
    lang === "es"
        ? `Visitar demo en vivo de ${project.name}`
        : `Visit live demo of ${project.name}`;
const sourceCodeAria =
    lang === "es"
        ? `Ver código fuente de ${project.name} en GitHub`
        : `View source code of ${project.name} on GitHub`;
const viewImageAria =
    lang === "es"
        ? `Ver imagen de ${project.name} en pantalla completa`
        : `View ${project.name} image in fullscreen`;
const techAria = lang === "es" ? "Tecnologías utilizadas" : "Technologies used";

// Responsive thumbnail paths
const thumb400 = project.image.replace(".webp", "-400w.webp");
const thumb640 = project.image;
---

<li
    class="project project-item"
    data-category={project.category}
>
    <button
        type="button"
        class="thumb project-card-media"
        data-title={project.name}
        data-image={project.imageFull || project.image}
        data-desc={project.description[lang]}
        data-badge={project.badge ? project.badge[lang] : ""}
        data-live={project.homepageUrl || ""}
        data-github={project.githubUrl}
        aria-label={viewImageAria}
    >
        <img
            src={thumb400}
            srcset={`${thumb400} 400w, ${thumb640} 640w`}
            sizes="(max-width: 640px) 100vw, 208px"
            alt={`Screenshot de ${project.name}`}
            width="400"
            height="200"
            loading="lazy"
            decoding="async"
        />
    </button>

    <div>
        <div class="pname">
            <h3>{project.name}</h3>
            {project.badge && <span class="badge">{project.badge[lang]}</span>}
        </div>
        <p class="pdom">{project.homepageUrl ? project.homepageUrl.replace("https://", "") : "github.com"}</p>
        <p class="pdesc">{project.description[lang]}</p>
        <p class="tags" aria-label={techAria}>
            {project.techTags.map((tag) => <span>{tag.name}</span>)}
        </p>
        <div class="links">
            {
                project.homepageUrl ? (
                    <a
                        href={project.homepageUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link ext"
                        aria-label={liveDemoAria}
                    >
                        {lang === "es" ? "Ver Sitio" : "Live Demo"}
                    </a>
                ) : (
                    <span class="stars">CLI / TUI Tool</span>
                )
            }
            <a
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="link ext"
                aria-label={sourceCodeAria}
            >
                {lang === "es" ? "Código" : "Source"}
            </a>
            {project.stars > 0 && <span class="stars">★ {project.stars}</span>}
        </div>
    </div>
</li>

<script>
    function initProjectCards() {
        document.querySelectorAll<HTMLElement>(".project-card-media").forEach((btn) => {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";

            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                window.dispatchEvent(
                    new CustomEvent("open-project-modal", {
                        detail: {
                            title: btn.dataset.title || "",
                            image: btn.dataset.image || "",
                            desc: btn.dataset.desc || "",
                            badge: btn.dataset.badge || "",
                            liveUrl: btn.dataset.live || "",
                            githubUrl: btn.dataset.github || "",
                        },
                    }),
                );
            });
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initProjectCards);
    } else {
        initProjectCards();
    }
    document.addEventListener("astro:page-load", initProjectCards);
</script>
