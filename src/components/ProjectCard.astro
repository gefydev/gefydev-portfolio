---
import type { Project } from '../data/projects';
import { ExternalLink, Github, Star, Sparkles, Music, Map } from 'lucide-astro';

interface Props {
  project: Project;
  lang: 'es' | 'en';
}

const { project, lang } = Astro.props;
const liveDemoAria = lang === 'es' ? `Visitar demo en vivo de ${project.name}` : `Visit live demo of ${project.name}`;
const sourceCodeAria = lang === 'es' ? `Ver código fuente de ${project.name} en GitHub` : `View source code of ${project.name} on GitHub`;
const techAria = lang === 'es' ? 'Tecnologías utilizadas' : 'Technologies used';
---

<article 
  class="group relative flex flex-col justify-between rounded-xl bg-zinc-950/80 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-300 overflow-hidden shadow-xs hover:shadow-xl hover:shadow-[#0db7b9]/5 hover:-translate-y-1 project-item"
  data-category={project.category}
>
  <div class="p-6 space-y-4">
    <div class="relative w-full h-44 rounded-lg bg-zinc-900/90 border border-zinc-800/80 overflow-hidden group/preview flex flex-col justify-between p-4">
      <div class="absolute inset-0 bg-gradient-to-tr from-zinc-950/80 via-transparent to-zinc-900/30"></div>
      
      {project.placeholderPattern === 'music' && (
        <div class="absolute inset-0 opacity-25 flex items-center justify-center pointer-events-none">
          <div class="w-16 h-16 rounded-2xl bg-[#735ed5]/20 border border-[#735ed5]/40 flex items-center justify-center text-purple-400">
            <Music class="w-8 h-8" />
          </div>
        </div>
      )}

      {project.placeholderPattern === 'crypto' && (
        <div class="absolute inset-0 opacity-25 flex items-center justify-center pointer-events-none">
          <svg class="w-full h-full text-[#0db7b9]" viewBox="0 0 400 150" fill="none" preserveAspectRatio="none">
            <path d="M0,120 Q80,40 160,90 T320,30 T400,60" stroke="currentColor" stroke-width="3" fill="none" />
            <path d="M0,120 Q80,40 160,90 T320,30 T400,60 L400,150 L0,150 Z" fill="currentColor" fill-opacity="0.1" />
          </svg>
        </div>
      )}

      {project.placeholderPattern === 'terminal' && (
        <div class="absolute inset-0 opacity-25 flex flex-col justify-center p-6 font-mono text-xs text-orange-400 pointer-events-none">
          <p class="font-bold">&gt; genacleaner --adb-connect</p>
          <p class="text-zinc-500">&gt; debloating system packages...</p>
          <p class="text-emerald-400">&gt; done [0.04s]</p>
        </div>
      )}

      {project.placeholderPattern === 'stream' && (
        <div class="absolute inset-0 opacity-25 flex items-center justify-center pointer-events-none">
          <div class="w-14 h-14 rounded-full border-2 border-purple-400 flex items-center justify-center">
            <span class="w-4 h-4 rounded-full bg-purple-400 animate-pulse"></span>
          </div>
        </div>
      )}

      {project.placeholderPattern === 'maps' && (
        <div class="absolute inset-0 opacity-25 flex items-center justify-center pointer-events-none">
          <Map class="w-16 h-16 text-[#0db7b9]" />
        </div>
      )}

      <div class="relative z-10 flex items-center justify-between w-full">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-sans font-semibold bg-zinc-900/90 border border-zinc-700/80 text-zinc-200">
          <span class="w-2 h-2 rounded-full" style={`background-color: ${project.accentColor};`}></span>
          <span>{project.name}</span>
        </span>

        {project.badge && (
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-sans font-medium bg-[#735ed5]/15 border border-[#735ed5]/30 text-purple-300">
            <Sparkles class="w-3 h-3 text-[#0db7b9]" />
            <span>{project.badge[lang]}</span>
          </span>
        )}
      </div>

      <div class="relative z-10 flex items-center justify-between text-xs font-sans text-zinc-400">
        <span class="text-zinc-400 font-mono text-[11px] truncate max-w-[200px]">
          {project.homepageUrl ? project.homepageUrl.replace('https://', '') : 'github.com'}
        </span>
        {project.stars > 0 && (
          <span class="flex items-center gap-1 text-amber-400 font-mono text-xs">
            <Star class="w-3.5 h-3.5 fill-amber-400/30" />
            <span>{project.stars}</span>
          </span>
        )}
      </div>
    </div>

    <div class="space-y-2">
      <h3 class="text-lg font-bold text-white font-sans group-hover:text-[#0db7b9] transition-colors">
        {project.name}
      </h3>
      <p class="text-sm text-zinc-300 leading-relaxed font-sans line-clamp-3">
        {project.description[lang]}
      </p>
    </div>
  </div>

  <div class="p-6 pt-0 space-y-4">
    <div class="flex flex-wrap gap-1.5" aria-label={techAria}>
      {project.techTags.map((tag) => (
        <span 
          class="px-2.5 py-0.5 rounded text-[11px] font-sans font-medium border"
          style={`color: ${tag.color}; background-color: ${tag.bg}; border-color: ${tag.border};`}
        >
          {tag.name}
        </span>
      ))}
    </div>

    <div class="pt-3 border-t border-zinc-800/80 flex items-center justify-between gap-3">
      {project.homepageUrl ? (
        <a
          href={project.homepageUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-[38px] rounded-lg bg-[#0db7b9]/10 hover:bg-[#0db7b9]/20 border border-[#0db7b9]/30 text-[#0db7b9] hover:text-cyan-200 text-xs font-sans font-medium transition-colors active:scale-[0.98]"
          aria-label={liveDemoAria}
        >
          <span>{lang === 'es' ? 'Ver Sitio' : 'Live Demo'}</span>
          <ExternalLink class="w-3.5 h-3.5" />
        </a>
      ) : (
        <span class="text-xs text-zinc-500 font-sans">{lang === 'es' ? 'CLI / Tool' : 'CLI / Tool'}</span>
      )}

      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 min-h-[38px] rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-xs font-sans font-medium transition-colors ml-auto active:scale-[0.98]"
        aria-label={sourceCodeAria}
      >
        <Github class="w-3.5 h-3.5" />
        <span>{lang === 'es' ? 'Código' : 'Source'}</span>
      </a>
    </div>
  </div>
</article>
