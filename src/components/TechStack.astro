---
import { techStack } from '../data/stack';
import { translations } from '../data/translations';
import TechIcon from './TechIcon.astro';
import { Cpu, Sparkles, Layers } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

const flagships = techStack.filter((t) => t.size === 'large');
const mediums = techStack.filter((t) => t.size === 'medium');
const compacts = techStack.filter((t) => t.size === 'small');
---

<section id="stack" class="py-20 md:py-28 border-b border-zinc-800/80 relative font-sans" aria-labelledby="stack-title">
  <!-- Subtle ambient background glow -->
  <div class="absolute inset-0 bg-radial from-[#0db7b9]/5 via-transparent to-transparent pointer-events-none opacity-40"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <!-- Section Header -->
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-[#0db7b9]">
        <Cpu class="w-3.5 h-3.5" />
        <span class="font-bold">03. // TECH_STACK & ECOSYSTEM</span>
      </div>
      <h2 id="stack-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
        {t.stack.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm max-w-2xl font-sans">
        {t.stack.sectionSubtitle}
      </p>
    </div>

    <!-- Bento Grid Container with Cursor Spotlight Tracking -->
    <div id="tech-bento-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">

      <!-- 1. Flagship Core Technologies (Large Bento Cards) -->
      {flagships.map((tech) => (
        <div
          class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 md:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
          style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
          data-color={tech.color}
        >
          <!-- Cursor Spotlight Overlay -->
          <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

          <div class="relative z-10 space-y-4">
            <!-- Header: SVG Logo + Role Badge -->
            <div class="flex items-start justify-between gap-4">
              <div
                class="p-3.5 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3 shadow-md"
                style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
              >
                <TechIcon name={tech.iconName} class="w-8 h-8" />
              </div>

              <span
                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-mono font-semibold border"
                style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
              >
                <Sparkles class="w-3 h-3" />
                <span>{tech.roleBadge[lang]}</span>
              </span>
            </div>

            <!-- Name & Bio -->
            <div class="space-y-1.5 pt-1">
              <h3 class="text-xl font-bold text-white font-sans group-hover:text-white transition-colors flex items-center gap-2">
                <span>{tech.name}</span>
              </h3>
              <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans">
                {tech.description[lang]}
              </p>
            </div>
          </div>

          <!-- Tags Footer -->
          <div class="relative z-10 pt-5 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1.5 font-mono text-[11px]">
            {tech.tags.map((tag) => (
              <span class="px-2 py-0.5 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}

      <!-- 2. Medium Web & Systems Technologies -->
      {mediums.map((tech) => (
        <div
          class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-5 sm:p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
          style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
          data-color={tech.color}
        >
          <!-- Cursor Spotlight Overlay -->
          <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

          <div class="relative z-10 space-y-3">
            <div class="flex items-center justify-between gap-3">
              <div
                class="p-2.5 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
              >
                <TechIcon name={tech.iconName} class="w-6 h-6" />
              </div>

              <span
                class="text-[10px] font-mono font-medium px-2 py-0.5 rounded border"
                style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
              >
                {tech.roleBadge[lang]}
              </span>
            </div>

            <div class="space-y-1">
              <h3 class="text-base font-bold text-white font-sans">
                {tech.name}
              </h3>
              <p class="text-xs text-zinc-300 leading-relaxed font-sans line-clamp-3">
                {tech.description[lang]}
              </p>
            </div>
          </div>

          <div class="relative z-10 pt-4 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400">
            {tech.tags.map((tag) => (
              <span class="px-1.5 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                {tag}
              </span>
            ))}
          </div>
        </div>
      ))}

      <!-- 3. Specialized Tools, Systems & DBs (Compact Bento Cards) -->
      {compacts.map((tech) => (
        <div
          class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-4 sm:p-5 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-sm"
          style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
          data-color={tech.color}
        >
          <!-- Cursor Spotlight Overlay -->
          <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

          <div class="relative z-10 space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <div
                class="p-2 rounded-lg border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
              >
                <TechIcon name={tech.iconName} class="w-5 h-5" />
              </div>

              <span class="text-[10px] font-mono text-zinc-400">
                {tech.tags[0]}
              </span>
            </div>

            <div>
              <h3 class="text-sm font-bold text-white font-sans">
                {tech.name}
              </h3>
              <p class="text-xs text-zinc-400 leading-relaxed font-sans line-clamp-2 mt-1">
                {tech.description[lang]}
              </p>
            </div>
          </div>

          <div class="relative z-10 pt-3 mt-2 border-t border-zinc-800/80 flex items-center justify-between text-[10px] font-mono text-zinc-500">
            <span class="truncate">{tech.roleBadge[lang]}</span>
          </div>
        </div>
      ))}

    </div>
  </div>
</section>

<style>
  .spotlight-overlay {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      var(--tech-bg, rgba(13, 183, 185, 0.15)),
      transparent 75%
    );
    box-shadow: inset 0 0 0 1px var(--tech-border, rgba(13, 183, 185, 0.3));
  }
</style>

<script>
  function initTechBento() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.bento-card'));
    if (cards.length === 0) return;

    let rafId: number | null = null;

    function handleMouseMove(e: MouseEvent) {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    const grid = document.getElementById('tech-bento-grid');
    grid?.addEventListener('mousemove', handleMouseMove, { passive: true });
  }

  document.addEventListener('astro:page-load', initTechBento);
</script>
