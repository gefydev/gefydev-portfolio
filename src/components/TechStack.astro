            transparent 75%
        );
        box-shadow: inset 0 0 0 1px var(--tech-border, rgba(13, 183, 185, 0.35));
    }
</style>

<script>
    function initTechBento() {
        const grid = document.getElementById("tech-bento-grid");
        if (!grid || (grid as HTMLElement).dataset.bound) return;
        (grid as HTMLElement).dataset.bound = "true";

        let rafId: number | null = null;

        function handleMouseMove(e: MouseEvent) {
            if (rafId) cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(() => {
                const targetCard = (e.target as HTMLElement)?.closest<HTMLElement>(".bento-card");
                if (targetCard) {
                    const rect = targetCard.getBoundingClientRect();
                    targetCard.style.setProperty("--mouse-x", `${e.clientX - rect.left}px`);
                    targetCard.style.setProperty("--mouse-y", `${e.clientY - rect.top}px`);
                }
            });
        }

        grid.addEventListener("mousemove", handleMouseMove, { passive: true });
    }

    document.addEventListener("astro:page-load", initTechBento);
</script>
