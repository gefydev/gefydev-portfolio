---
import { techStack } from "../data/stack";
import { translations } from "../data/translations";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

const groups = [
    { category: "web-core", title: t.stack.webCore },
    { category: "languages", title: t.stack.languages },
    { category: "ecosystem", title: t.stack.ecosystem },
    { category: "tools", title: t.stack.tools },
    { category: "databases", title: t.stack.databases },
    { category: "systems", title: t.stack.systems },
].map((g) => ({
    ...g,
    items: techStack.filter((item) => item.category === g.category),
}));
---

<section id="stack" class="section section-cv" aria-labelledby="stack-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="stack-title">{t.stack.sectionTitle}</h2>
            <p class="sub">{t.stack.sectionSubtitle}</p>
        </div>

        <div>
            {
                groups.map((g) => (
                    <div class="group">
                        <h3>{g.title}</h3>
                        <div>
                            {g.items.map((item) => (
                                <div class="tech">
                                    <p class="tech-name">{item.name}</p>
                                    <span class="tech-role">
                                        {item.roleBadge[lang]}
                                    </span>
                                    <p class="tech-desc">
                                        {item.description[lang]}
                                    </p>
                                    <p class="tags">
                                        {item.tags.map((tag) => (
                                            <span>{tag}</span>
                                        ))}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
