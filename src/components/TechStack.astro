---
import { techStack } from '../data/stack';
import { translations } from '../data/translations';
import { Cpu, Terminal, CheckCircle2, Zap } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

const categories = [
  { key: 'languages', title: t.stack.languages },
  { key: 'frameworks', title: t.stack.frameworks },
  { key: 'tools', title: t.stack.tools },
  { key: 'databases', title: t.stack.databases },
  { key: 'systems', title: t.stack.systems },
] as const;
---

<section id="stack" class="py-24 border-t border-zinc-800/80 relative font-sans" aria-labelledby="stack-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono font-semibold tracking-wider uppercase text-[#0db7b9]">
        <Cpu class="w-3.5 h-3.5" />
        <span>02 // {lang === 'es' ? 'TECNOLOGÍAS' : 'TECH STACK'}</span>
      </div>
      <h2 id="stack-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
        {t.stack.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
        {t.stack.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8 space-y-8">
        {categories.map((cat) => {
          const items = techStack.filter((item) => item.category === cat.key);
          if (items.length === 0) return null;
          return (
            <div class="space-y-3">
              <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-2">
                <span class="w-2 h-2 rounded-xs bg-[#0db7b9]"></span>
                <span>{cat.title}</span>
              </h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {items.map((tech) => (
                  <div 
                    class="group relative rounded-xl bg-zinc-950/70 border border-zinc-800/80 hover:border-zinc-700 p-4 transition-all duration-200"
                    style={`border-left: 3px solid ${tech.color};`}
                  >
                    <div class="flex items-center justify-between mb-2">
                      <span class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors flex items-center gap-2">
                        <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${tech.color};`}></span>
                        <span>{tech.name}</span>
                      </span>

                      <span 
                        class="text-[11px] font-medium px-2 py-0.5 rounded"
                        style={`color: ${tech.color}; background-color: ${tech.bg}; border: 1px solid ${tech.border};`}
                      >
                        {tech.level.toUpperCase()}
                      </span>
                    </div>

                    <p class="text-xs text-zinc-300 leading-relaxed">
                      {tech.description[lang]}
                    </p>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>

      <div class="lg:col-span-4 space-y-4">
        <div class="rounded-2xl bg-zinc-950 border border-zinc-800 p-5 space-y-4 text-xs shadow-lg">
          <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
            <div class="flex items-center gap-2 text-zinc-400 font-mono">
              <Terminal class="w-3.5 h-3.5 text-[#0db7b9]" />
              <span class="text-xs text-zinc-200 font-bold">gefy@workstation:~</span>
            </div>
            <div class="flex gap-1.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
            </div>
          </div>

          <div class="space-y-3 font-mono text-zinc-400 leading-relaxed overflow-x-auto">
            <div>
              <p class="text-zinc-500">$ rustc --version</p>
              <p class="text-[#f97316] font-semibold">rustc 1.8x (edition 2021)</p>
            </div>

            <div>
              <p class="text-zinc-500">$ bun --version</p>
              <p class="text-cyan-300 font-semibold">1.3.14</p>
            </div>

            <div>
              <p class="text-zinc-500">$ gh auth status</p>
              <p class="text-emerald-400">✓ Logged in as @gefydev</p>
            </div>

            <div>
              <p class="text-zinc-500">$ astro check</p>
              <p class="text-emerald-400 flex items-center gap-1.5">
                <CheckCircle2 class="w-3.5 h-3.5" />
                <span>Result: 0 errors, 0 warnings</span>
              </p>
            </div>

            <div class="pt-2 border-t border-zinc-800/80 font-sans">
              <p class="text-zinc-500 text-[11px] font-mono">{lang === 'es' ? '// Filosofía de desarrollo' : '// Engineering philosophy'}</p>
              <p class="text-zinc-300 text-xs italic mt-1">
                {lang === 'es' 
                  ? '"Comprender el funcionamiento a bajo nivel, optimizar cada recurso y priorizar velocidad pura."'
                  : '"Understand low-level mechanics, eliminate memory overhead, and prioritize pure performance."'}
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl bg-gradient-to-br from-[#0db7b9]/10 via-zinc-950 to-[#735ed5]/10 border border-[#735ed5]/30 p-5 space-y-2">
          <div class="flex items-center gap-2 text-white text-xs font-bold">
            <Zap class="w-4 h-4 text-[#0db7b9]" />
            <span>{lang === 'es' ? 'Optimización & Rendimiento' : 'Optimization & Performance'}</span>
          </div>
          <p class="text-xs text-zinc-300 leading-relaxed">
            {lang === 'es'
              ? 'Lighthouse 100/100, cero movimientos de diseño (CLS = 0), First Contentful Paint sub-segundo y código 100% tipado y limpio.'
              : 'Lighthouse 100/100, zero layout shifts (CLS = 0), sub-second First Contentful Paint, and strictly typed clean codebase.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
