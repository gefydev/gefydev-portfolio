---
import { techStack } from "../data/stack";
import { translations } from "../data/translations";
import TechIcon from "./TechIcon.astro";
import {
    Cpu,
    Sparkles,
    Code2,
    TerminalSquare,
    Wrench,
    Database,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

const ts = techStack.find((t) => t.icon === "typescript")!;
const js = techStack.find((t) => t.icon === "javascript")!;
const react = techStack.find((t) => t.icon === "react")!;
const astro = techStack.find((t) => t.icon === "astro")!;

const rust = techStack.find((t) => t.icon === "rust")!;
const c = techStack.find((t) => t.icon === "c")!;
const cpp = techStack.find((t) => t.icon === "cpp")!;
const python = techStack.find((t) => t.icon === "python")!;

const tailwind = techStack.find((t) => t.icon === "tailwind")!;
const bun = techStack.find((t) => t.icon === "bun")!;
const vite = techStack.find((t) => t.icon === "vite")!;

const linux = techStack.find((t) => t.icon === "linux")!;
const db = techStack.find((t) => t.icon === "database")!;
const git = techStack.find((t) => t.icon === "git")!;
const adb = techStack.find((t) => t.icon === "adb")!;
---

<section
    id="stack"
    class="py-20 md:py-28 border-b border-zinc-800/80 relative font-sans section-cv"
    aria-labelledby="stack-title"
>
    <!-- Ambient background glow -->
    <div
        class="absolute inset-0 bg-radial from-[#0db7b9]/5 via-transparent to-transparent pointer-events-none opacity-40"
    >
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">
        <!-- Section Header -->
        <div class="space-y-3">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-[#0db7b9]"
            >
                <Cpu class="w-3.5 h-3.5" />
                <span class="font-bold">02. // TECH_STACK & ECOSYSTEM</span>
            </div>
            <h2
                id="stack-title"
                class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans"
            >
                {t.stack.sectionTitle}
            </h2>
            <p class="text-zinc-400 text-sm sm:text-base max-w-2xl font-sans">
                {t.stack.sectionSubtitle}
            </p>
        </div>

        <!-- Asymmetric Bento Grid Container with Cursor Spotlight -->
        <div id="tech-bento-grid" class="space-y-10">
            <!-- ========================================== -->
            <!-- SECTION 1: PRIMARY WEB CORE (TypeScript, JavaScript, React, Astro) -->
            <!-- ========================================== -->
            <div class="space-y-3">
                <div
                    class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400"
                >
                    <Code2 class="w-4 h-4 text-[#0db7b9]" />
                    <span>{t.stack.webCore.toUpperCase()}</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-5">
                    <!-- 1. TypeScript (Width: 7 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-7 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
                        style={`--tech-color: ${ts.color}; --tech-bg: ${ts.bg}; --tech-border: ${ts.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-4">
                            <div class="flex items-start justify-between gap-3">
                                <div
                                    class="p-3.5 rounded-2xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-md"
                                    style={`color: ${ts.color}; background-color: ${ts.bg}; border-color: ${ts.border};`}
                                >
                                    <TechIcon
                                        name={ts.icon}
                                        class="w-10 h-10"
                                    />
                                </div>

                                <span
                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold border"
                                    style={`color: ${ts.color}; background-color: ${ts.bg}; border-color: ${ts.border};`}
                                >
                                    <Sparkles class="w-3 h-3" />
                                    <span>{ts.roleBadge[lang]}</span>
                                </span>
                            </div>

                            <div class="space-y-2">
                                <h3
                                    class="text-xl sm:text-2xl font-bold text-white font-sans"
                                >
                                    {ts.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {ts.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-5 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1.5 font-mono text-[11px]"
                        >
                            {
                                ts.tags.map((tag) => (
                                    <span class="px-2.5 py-1 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 2. JavaScript (Width: 5 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-5 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
                        style={`--tech-color: ${js.color}; --tech-bg: ${js.bg}; --tech-border: ${js.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-4">
                            <div class="flex items-start justify-between gap-3">
                                <div
                                    class="p-3.5 rounded-2xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-md"
                                    style={`color: ${js.color}; background-color: ${js.bg}; border-color: ${js.border};`}
                                >
                                    <TechIcon
                                        name={js.icon}
                                        class="w-10 h-10"
                                    />
                                </div>

                                <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono font-medium border"
                                    style={`color: ${js.color}; background-color: ${js.bg}; border-color: ${js.border};`}
                                >
                                    <span>{js.roleBadge[lang]}</span>
                                </span>
                            </div>

                            <div class="space-y-2">
                                <h3
                                    class="text-xl sm:text-2xl font-bold text-white font-sans"
                                >
                                    {js.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {js.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-5 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1.5 font-mono text-[11px]"
                        >
                            {
                                js.tags.map((tag) => (
                                    <span class="px-2.5 py-1 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 3. React / Preact (Width: 5 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-5 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
                        style={`--tech-color: ${react.color}; --tech-bg: ${react.bg}; --tech-border: ${react.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-4">
                            <div class="flex items-start justify-between gap-3">
                                <div
                                    class="p-3.5 rounded-2xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-md"
                                    style={`color: ${react.color}; background-color: ${react.bg}; border-color: ${react.border};`}
                                >
                                    <TechIcon
                                        name={react.icon}
                                        class="w-10 h-10"
                                    />
                                </div>

                                <span
                                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-mono font-medium border"
                                    style={`color: ${react.color}; background-color: ${react.bg}; border-color: ${react.border};`}
                                >
                                    <span>{react.roleBadge[lang]}</span>
                                </span>
                            </div>

                            <div class="space-y-2">
                                <h3
                                    class="text-xl sm:text-2xl font-bold text-white font-sans"
                                >
                                    {react.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {react.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-5 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1.5 font-mono text-[11px]"
                        >
                            {
                                react.tags.map((tag) => (
                                    <span class="px-2.5 py-1 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 4. Astro (Width: 7 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-7 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
                        style={`--tech-color: ${astro.color}; --tech-bg: ${astro.bg}; --tech-border: ${astro.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-4">
                            <div class="flex items-start justify-between gap-3">
                                <div
                                    class="p-3.5 rounded-2xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 shadow-md"
                                    style={`color: ${astro.color}; background-color: ${astro.bg}; border-color: ${astro.border};`}
                                >
                                    <TechIcon
                                        name={astro.icon}
                                        class="w-10 h-10"
                                    />
                                </div>

                                <span
                                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-semibold border"
                                    style={`color: ${astro.color}; background-color: ${astro.bg}; border-color: ${astro.border};`}
                                >
                                    <Sparkles class="w-3 h-3" />
                                    <span>{astro.roleBadge[lang]}</span>
                                </span>
                            </div>

                            <div class="space-y-2">
                                <h3
                                    class="text-xl sm:text-2xl font-bold text-white font-sans"
                                >
                                    {astro.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {astro.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-5 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1.5 font-mono text-[11px]"
                        >
                            {
                                astro.tags.map((tag) => (
                                    <span class="px-2.5 py-1 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 2: LOW-LEVEL & CS FOUNDATIONS (Rust, C, C++, Python) -->
            <!-- ========================================== -->
            <div class="space-y-3">
                <div
                    class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400"
                >
                    <TerminalSquare class="w-4 h-4 text-purple-400" />
                    <span>{t.stack.languages.toUpperCase()}</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-5">
                    <!-- 1. Rust (Width: 7 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-7 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
                        style={`--tech-color: ${rust.color}; --tech-bg: ${rust.bg}; --tech-border: ${rust.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-3">
                            <div
                                class="flex items-center justify-between gap-3"
                            >
                                <div
                                    class="p-3 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                                    style={`color: ${rust.color}; background-color: ${rust.bg}; border-color: ${rust.border};`}
                                >
                                    <TechIcon
                                        name={rust.icon}
                                        class="w-8 h-8"
                                    />
                                </div>

                                <span
                                    class="text-[11px] font-mono font-medium px-2.5 py-0.5 rounded-full border"
                                    style={`color: ${rust.color}; background-color: ${rust.bg}; border-color: ${rust.border};`}
                                >
                                    {rust.roleBadge[lang]}
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <h3
                                    class="text-lg sm:text-xl font-bold text-white font-sans"
                                >
                                    {rust.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {rust.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-4 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400"
                        >
                            {
                                rust.tags.map((tag) => (
                                    <span class="px-2 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 2. C (Width: 5 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-5 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
                        style={`--tech-color: ${c.color}; --tech-bg: ${c.bg}; --tech-border: ${c.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-3">
                            <div
                                class="flex items-center justify-between gap-3"
                            >
                                <div
                                    class="p-3 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                                    style={`color: ${c.color}; background-color: ${c.bg}; border-color: ${c.border};`}
                                >
                                    <TechIcon name={c.icon} class="w-8 h-8" />
                                </div>

                                <span
                                    class="text-[11px] font-mono font-medium px-2.5 py-0.5 rounded-full border truncate max-w-[170px]"
                                    style={`color: ${c.color}; background-color: ${c.bg}; border-color: ${c.border};`}
                                >
                                    {c.roleBadge[lang]}
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <h3
                                    class="text-lg sm:text-xl font-bold text-white font-sans"
                                >
                                    {c.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {c.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-4 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400"
                        >
                            {
                                c.tags.map((tag) => (
                                    <span class="px-2 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 3. C++ (Width: 5 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-5 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
                        style={`--tech-color: ${cpp.color}; --tech-bg: ${cpp.bg}; --tech-border: ${cpp.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-3">
                            <div
                                class="flex items-center justify-between gap-3"
                            >
                                <div
                                    class="p-3 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                                    style={`color: ${cpp.color}; background-color: ${cpp.bg}; border-color: ${cpp.border};`}
                                >
                                    <TechIcon name={cpp.icon} class="w-8 h-8" />
                                </div>

                                <span
                                    class="text-[11px] font-mono font-medium px-2.5 py-0.5 rounded-full border truncate max-w-[170px]"
                                    style={`color: ${cpp.color}; background-color: ${cpp.bg}; border-color: ${cpp.border};`}
                                >
                                    {cpp.roleBadge[lang]}
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <h3
                                    class="text-lg sm:text-xl font-bold text-white font-sans"
                                >
                                    {cpp.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {cpp.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-4 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400"
                        >
                            {
                                cpp.tags.map((tag) => (
                                    <span class="px-2 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>

                    <!-- 4. Python (Width: 7 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-7 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
                        style={`--tech-color: ${python.color}; --tech-bg: ${python.bg}; --tech-border: ${python.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-3">
                            <div
                                class="flex items-center justify-between gap-3"
                            >
                                <div
                                    class="p-3 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                                    style={`color: ${python.color}; background-color: ${python.bg}; border-color: ${python.border};`}
                                >
                                    <TechIcon
                                        name={python.icon}
                                        class="w-8 h-8"
                                    />
                                </div>

                                <span
                                    class="text-[11px] font-mono font-medium px-2.5 py-0.5 rounded-full border"
                                    style={`color: ${python.color}; background-color: ${python.bg}; border-color: ${python.border};`}
                                >
                                    {python.roleBadge[lang]}
                                </span>
                            </div>

                            <div class="space-y-1.5">
                                <h3
                                    class="text-lg sm:text-xl font-bold text-white font-sans"
                                >
                                    {python.name}
                                </h3>
                                <p
                                    class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-sans"
                                >
                                    {python.description[lang]}
                                </p>
                            </div>
                        </div>

                        <div
                            class="relative z-10 pt-4 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400"
                        >
                            {
                                python.tags.map((tag) => (
                                    <span class="px-2 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                                        {tag}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- SECTION 3: WEB ECOSYSTEM & RUNTIMES (Tailwind, Bun/Node, Vite) -->
            <!-- ========================================== -->
            <div class="space-y-3">
                <div
                    class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400"
                >
                    <Wrench class="w-4 h-4 text-cyan-400" />
                    <span>{t.stack.ecosystem.toUpperCase()}</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-5">
                    <!-- Tailwind CSS (Width: 5 cols) -->
                    <div
                        class="bento-card col-span-12 md:col-span-5 group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-5 sm:p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
                        style={`--tech-color: ${tailwind.color}; --tech-bg: ${tailwind.bg}; --tech-border: ${tailwind.border};`}
                    >
                        <div
                            class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"
                        >
                        </div>

                        <div class="relative z-10 space-y-3">
                            <div
                                class="flex items-center justify-between gap-3"
                            >
                                <div
                                    class="p-2.5 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                                    style={`color: ${tailwind.color}; background-color: ${tailwind.bg}; border-color: ${tailwind.border};`}
                                >
                                    <TechIcon
                                        name={tailwind.icon}
                                        class="w-7 h-7"
                                    />
                                </div>

                                <span
                                    class="text-[10px] font-mono font-medium px-2 py-0.5 rounded border"
                                    style={`color: ${tailwind.color}; background-color: ${tailwind.bg}; border-color: ${tailwind.border};`}
                                >
                                    {tailwind.roleBadge[lang]}
                                </span>
