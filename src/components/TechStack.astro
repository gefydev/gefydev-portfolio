---
import { techStack } from "../data/stack";
import { translations } from "../data/translations";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

// Logos de simple-icons: los mismos símbolos <symbol id="i-…"> que dibuja HeroStage.astro (sprite en la misma página).
const logos: Record<string, string[]> = {
    "TypeScript": ["typescript"],
    "JavaScript (ESNext)": ["javascript"],
    "React / Preact": ["react"],
    "Astro": ["astro"],
    "Rust": ["rust"],
    "C": ["c"],
    "C++": ["cplusplus"],
    "Python": ["python"],
    "Tailwind CSS": ["tailwindcss"],
    "Bun & Node.js": ["bun", "nodedotjs"],
    "Vite": ["vite"],
    "Linux & Shell Scripting": ["linux"],
    "PostgreSQL & SQLite": ["postgresql", "sqlite"],
    "Git & GitHub Actions": ["git", "githubactions"],
    "Android Debug Bridge (ADB)": ["android"],
};

const groups = [
    { category: "web-core", title: t.stack.webCore },
    { category: "languages", title: t.stack.languages },
    { category: "ecosystem", title: t.stack.ecosystem },
    { category: "tools", title: t.stack.tools },
    { category: "databases", title: t.stack.databases },
    { category: "systems", title: t.stack.systems },
].map((g) => ({
    ...g,
    items: techStack.filter((item) => item.category === g.category),
}));
---

<section id="stack" class="section section-cv" aria-labelledby="stack-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="stack-title">{t.stack.sectionTitle}</h2>
            <p class="sub">{t.stack.sectionSubtitle}</p>
        </div>

        <div>
            {
                groups.map((g) => (
                    <div class="group">
                        <h3>{g.title}</h3>
                        <div>
                            {g.items.map((item) => (
                                <div class="tech">
                                    <div class="tech-head">
                                        <span class="tech-logos" aria-hidden="true">
                                            {(logos[item.name] ?? []).map((id) => (
                                                <span class="tech-logo"><svg focusable="false"><use href={`#i-${id}`} /></svg></span>
                                            ))}
                                        </span>
                                        <div class="tech-id">
                                            <p class="tech-name">{item.name}</p>
                                            <span class="tech-role">
                                                {item.roleBadge[lang]}
                                            </span>
                                        </div>
                                    </div>
                                    <p class="tech-desc">
                                        {item.description[lang]}
                                    </p>
                                    <p class="tags">
                                        {item.tags.map((tag) => (
                                            <span>{tag}</span>
                                        ))}
                                    </p>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
