---
import { techStack } from '../data/stack';
import { translations } from '../data/translations';
import TechIcon from './TechIcon.astro';
import { Cpu, Sparkles, Code2, TerminalSquare, Wrench, Database } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

const webCore = techStack.filter((t) => t.category === 'web-core');
const languages = techStack.filter((t) => t.category === 'languages');
const ecosystem = techStack.filter((t) => t.category === 'ecosystem');
const systemsAndTools = techStack.filter((t) => ['systems', 'databases', 'tools'].includes(t.category));
---

<section id="stack" class="py-20 md:py-28 border-b border-zinc-800/80 relative font-sans" aria-labelledby="stack-title">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 bg-radial from-[#0db7b9]/5 via-transparent to-transparent pointer-events-none opacity-40"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10 space-y-12">

    <!-- Section Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-[#0db7b9]">
        <Cpu class="w-3.5 h-3.5" />
        <span class="font-bold">03. // TECH_STACK & ECOSYSTEM</span>
      </div>
      <h2 id="stack-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
        {t.stack.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm max-w-2xl font-sans">
        {t.stack.sectionSubtitle}
      </p>
    </div>

    <!-- Bento Grid Container with Cursor Spotlight -->
    <div id="tech-bento-grid" class="space-y-8">

      <!-- TIER 1: PRIMARY WEB CORE (TypeScript, JavaScript, React, Astro) -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400">
          <Code2 class="w-3.5 h-3.5 text-[#0db7b9]" />
          <span>{t.stack.webCore.toUpperCase()}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {webCore.map((tech) => (
            <div
              class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-5 sm:p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-lg"
              style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
            >
              <!-- Spotlight Overlay -->
              <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <div class="relative z-10 space-y-4">
                <div class="flex items-start justify-between gap-2">
                  <div
                    class="p-3 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3 shadow-md"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    <TechIcon name={tech.icon} class="w-7 h-7" />
                  </div>

                  <span
                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold border truncate max-w-[140px]"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    <Sparkles class="w-2.5 h-2.5 shrink-0" />
                    <span class="truncate">{tech.roleBadge[lang]}</span>
                  </span>
                </div>

                <div class="space-y-1.5 pt-1">
                  <h3 class="text-lg font-bold text-white font-sans">
                    {tech.name}
                  </h3>
                  <p class="text-xs text-zinc-300 leading-relaxed font-sans">
                    {tech.description[lang]}
                  </p>
                </div>
              </div>

              <!-- Tags Footer -->
              <div class="relative z-10 pt-4 mt-4 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px]">
                {tech.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded bg-zinc-900/90 border border-zinc-800 text-zinc-300 group-hover:border-zinc-700 transition-colors">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TIER 2: LOW-LEVEL & CS FOUNDATIONS (Rust, C, C++, Python) -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400">
          <TerminalSquare class="w-3.5 h-3.5 text-purple-400" />
          <span>{t.stack.languages.toUpperCase()}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {languages.map((tech) => (
            <div
              class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-5 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
              style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
            >
              <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <div class="relative z-10 space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <div
                    class="p-2.5 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    <TechIcon name={tech.icon} class="w-6 h-6" />
                  </div>

                  <span
                    class="text-[10px] font-mono font-medium px-2 py-0.5 rounded border truncate max-w-[140px]"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    {tech.roleBadge[lang]}
                  </span>
                </div>

                <div class="space-y-1">
                  <h3 class="text-base font-bold text-white font-sans">
                    {tech.name}
                  </h3>
                  <p class="text-xs text-zinc-300 leading-relaxed font-sans">
                    {tech.description[lang]}
                  </p>
                </div>
              </div>

              <div class="relative z-10 pt-3 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400">
                {tech.tags.map((tag) => (
                  <span class="px-1.5 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TIER 3: WEB ECOSYSTEM & RUNTIMES (Tailwind CSS, Bun & Node.js, Vite) -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400">
          <Wrench class="w-3.5 h-3.5 text-cyan-400" />
          <span>{t.stack.ecosystem.toUpperCase()}</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {ecosystem.map((tech) => (
            <div
              class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-5 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-md"
              style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
            >
              <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <div class="relative z-10 space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <div
                    class="p-2.5 rounded-xl border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    <TechIcon name={tech.icon} class="w-6 h-6" />
                  </div>

                  <span
                    class="text-[10px] font-mono font-medium px-2 py-0.5 rounded border"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    {tech.roleBadge[lang]}
                  </span>
                </div>

                <div class="space-y-1">
                  <h3 class="text-base font-bold text-white font-sans">
                    {tech.name}
                  </h3>
                  <p class="text-xs text-zinc-300 leading-relaxed font-sans">
                    {tech.description[lang]}
                  </p>
                </div>
              </div>

              <div class="relative z-10 pt-3 mt-3 border-t border-zinc-800/80 flex flex-wrap gap-1 font-mono text-[10px] text-zinc-400">
                {tech.tags.map((tag) => (
                  <span class="px-1.5 py-0.5 rounded bg-zinc-900/80 border border-zinc-800">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- TIER 4: DEVOPS, DATA & SYSTEMS (Linux, PostgreSQL/SQLite, Git/CI, ADB) -->
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono font-semibold text-zinc-400">
          <Database class="w-3.5 h-3.5 text-emerald-400" />
          <span>{lang === 'es' ? 'SISTEMAS, DATOS & HERRAMIENTAS' : 'SYSTEMS, DATA & TOOLS'}</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {systemsAndTools.map((tech) => (
            <div
              class="bento-card group relative rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-zinc-700 p-4 sm:p-5 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:-translate-y-1 shadow-sm"
              style={`--tech-color: ${tech.color}; --tech-bg: ${tech.bg}; --tech-border: ${tech.border};`}
            >
              <div class="spotlight-overlay pointer-events-none absolute -inset-px opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>

              <div class="relative z-10 space-y-2.5">
                <div class="flex items-center justify-between gap-2">
                  <div
                    class="p-2 rounded-lg border flex items-center justify-center transition-transform duration-300 group-hover:scale-105"
                    style={`color: ${tech.color}; background-color: ${tech.bg}; border-color: ${tech.border};`}
                  >
                    <TechIcon name={tech.icon} class="w-5 h-5" />
                  </div>

                  <span class="text-[10px] font-mono text-zinc-400 truncate max-w-[120px]">
                    {tech.tags[0]}
                  </span>
                </div>

                <div>
                  <h3 class="text-sm font-bold text-white font-sans">
                    {tech.name}
                  </h3>
                  <p class="text-xs text-zinc-400 leading-relaxed font-sans line-clamp-2 mt-1">
                    {tech.description[lang]}
                  </p>
                </div>
              </div>

              <div class="relative z-10 pt-3 mt-2 border-t border-zinc-800/80 flex items-center justify-between text-[10px] font-mono text-zinc-500">
                <span class="truncate">{tech.roleBadge[lang]}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .spotlight-overlay {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      var(--tech-bg, rgba(13, 183, 185, 0.15)),
      transparent 75%
    );
    box-shadow: inset 0 0 0 1px var(--tech-border, rgba(13, 183, 185, 0.3));
  }
</style>

<script>
  function initTechBento() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.bento-card'));
    if (cards.length === 0) return;

    let rafId: number | null = null;

    function handleMouseMove(e: MouseEvent) {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        cards.forEach((card) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    }

    const grid = document.getElementById('tech-bento-grid');
    grid?.addEventListener('mousemove', handleMouseMove, { passive: true });
  }

  document.addEventListener('astro:page-load', initTechBento);
</script>
