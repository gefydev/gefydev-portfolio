---
import { translations } from '../data/translations';
import { Mail, Github, Twitter, Copy, Check, Send, ArrowUpRight, MessageSquareCode } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
const email = 'genafeeboyapur@gmail.com';
---

<section id="contact" class="py-24 border-t border-zinc-800/80 relative" aria-labelledby="contact-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-mono text-rose-400">
        <Mail class="w-3.5 h-3.5" />
        <span>04 // {lang === 'es' ? 'CONEXIÓN' : 'CONNECT'}</span>
      </div>
      <h2 id="contact-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
        {t.contact.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base font-sans max-w-xl">
        {t.contact.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-7 rounded-2xl bg-zinc-950/80 border border-zinc-800 p-8 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <h3 class="text-2xl font-bold text-white font-sans">
            {lang === 'es' ? 'Construyamos algo increíble juntos' : "Let's build something exceptional"}
          </h3>
          <p class="text-zinc-400 text-sm font-sans leading-relaxed">
            {t.contact.directMessage}
          </p>
        </div>

        <div class="space-y-3 pt-4 border-t border-zinc-800/80 font-mono text-xs">
          <div class="p-4 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <div class="p-2 rounded-lg bg-sky-500/10 border border-sky-500/30 text-sky-400">
                <Mail class="w-4 h-4" />
              </div>
              <div>
                <span class="text-zinc-500 block text-[10px] uppercase font-bold">{t.contact.emailLabel}</span>
                <span class="text-zinc-200 text-xs sm:text-sm font-semibold">{email}</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <button
                id="contact-copy-email-btn"
                type="button"
                data-email={email}
                class="px-3 py-2 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-300 hover:text-white text-xs font-mono transition-colors flex items-center gap-1.5 cursor-pointer"
                aria-label="Copiar email al portapapeles"
              >
                <Copy class="w-3.5 h-3.5 contact-copy-icon" />
                <Check class="w-3.5 h-3.5 contact-check-icon hidden text-emerald-400" />
                <span class="contact-copy-label">{t.contact.copyEmailBtn}</span>
              </button>

              <a
                href={`mailto:${email}?subject=Hola%20GenaDeev!`}
                class="px-3 py-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-zinc-950 font-semibold text-xs font-sans transition-colors flex items-center gap-1.5"
              >
                <Send class="w-3.5 h-3.5" />
                <span>{t.contact.sendEmailBtn}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
        <a
          href="https://github.com/GenaDeev"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 p-5 flex items-center justify-between transition-all duration-200 hover:-translate-y-0.5"
        >
          <div class="flex items-center gap-3.5">
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 group-hover:text-white group-hover:border-zinc-700 transition-colors">
              <Github class="w-5 h-5" />
            </div>
            <div>
              <p class="font-mono text-sm font-semibold text-zinc-200 group-hover:text-sky-300 transition-colors">GitHub</p>
              <p class="text-xs font-mono text-zinc-500">@GenaDeev</p>
            </div>
          </div>
          <ArrowUpRight class="w-4 h-4 text-zinc-600 group-hover:text-sky-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
        </a>

        <a
          href="https://x.com/GenaDeev"
          target="_blank"
          rel="noopener noreferrer"
          class="group rounded-xl bg-zinc-950/80 border border-zinc-800 hover:border-zinc-700 p-5 flex items-center justify-between transition-all duration-200 hover:-translate-y-0.5"
        >
          <div class="flex items-center gap-3.5">
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300 group-hover:text-white group-hover:border-zinc-700 transition-colors">
              <Twitter class="w-5 h-5" />
            </div>
            <div>
              <p class="font-mono text-sm font-semibold text-zinc-200 group-hover:text-sky-300 transition-colors">X (Twitter)</p>
              <p class="text-xs font-mono text-zinc-500">@GenaDeev</p>
            </div>
          </div>
          <ArrowUpRight class="w-4 h-4 text-zinc-600 group-hover:text-sky-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
        </a>

        <div class="rounded-xl bg-zinc-950/80 border border-zinc-800 p-5 flex items-center justify-between">
          <div class="flex items-center gap-3.5">
            <div class="p-2.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-300">
              <MessageSquareCode class="w-5 h-5 text-emerald-400" />
            </div>
            <div>
              <p class="font-mono text-sm font-semibold text-zinc-200">Discord</p>
              <p class="text-xs font-mono text-zinc-500">genadeev</p>
            </div>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
            Active
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('contact-copy-email-btn');
  const copyIcon = copyBtn?.querySelector('.contact-copy-icon');
  const checkIcon = copyBtn?.querySelector('.contact-check-icon');
  const copyLabel = copyBtn?.querySelector('.contact-copy-label');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      if (copyLabel) copyLabel.textContent = '¡Copiado!';

      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        if (copyLabel) copyLabel.textContent = copyBtn.getAttribute('aria-label')?.includes('Copy') ? 'Copy Email' : 'Copiar Email';
      }, 2500);
    } catch {}
  });
</script>
