---
import { translations } from "../data/translations";
import {
    Mail,
    Github,
    Linkedin,
    Copy,
    Check,
    Send,
    ArrowUpRight,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
const email = "hi@gefy.dev";

const copyEmailAria =
    lang === "es"
        ? "Copiar correo electrónico al portapapeles"
        : "Copy email address to clipboard";
const githubAria =
    lang === "es"
        ? "Abrir perfil de GitHub de GefyDev"
        : "Open GefyDev GitHub profile";
const linkedinAria =
    lang === "es"
        ? "Abrir perfil de LinkedIn de GefyDev"
        : "Open GefyDev LinkedIn profile";
---

<section
    id="contact"
    class="py-24 border-t border-zinc-800/80 relative font-sans section-cv"
    aria-labelledby="contact-title"
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="space-y-3 mb-12">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono font-semibold tracking-wider uppercase text-[#0db7b9]"
            >
                <Mail class="w-3.5 h-3.5" />
                <span>04 // {lang === "es" ? "CONEXIÓN" : "CONNECT"}</span>
            </div>
            <h2
                id="contact-title"
                class="text-3xl sm:text-4xl font-bold tracking-tight text-white"
            >
                {t.contact.sectionTitle}
            </h2>
            <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
                {t.contact.sectionSubtitle}
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
            <div
                class="lg:col-span-8 rounded-2xl bg-zinc-950/80 border border-zinc-800 p-8 space-y-6 flex flex-col justify-between shadow-xl"
            >
                <div class="space-y-4">
                    <h3 class="text-2xl font-bold text-white">
                        {
                            lang === "es"
                                ? "Construyamos algo de alto impacto"
                                : "Let's build high-impact software"
                        }
                    </h3>
                    <p
                        class="text-zinc-300 text-sm sm:text-base leading-relaxed max-w-2xl"
                    >
                        {t.contact.directMessage}
                    </p>
                </div>

                <!--email_off-->
                <div class="space-y-3 pt-4 border-t border-zinc-800/80 text-xs">
                    <div
                        class="p-4 rounded-xl bg-zinc-900/70 border border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="p-2.5 rounded-xl bg-[#0db7b9]/15 border border-[#0db7b9]/30 text-[#0db7b9]"
                            >
                                <Mail class="w-5 h-5" />
                            </div>
                            <div>
                                <span
                                    class="text-zinc-400 block text-[11px] uppercase font-semibold"
                                    >{t.contact.emailLabel}</span
                                >
                                <span
                                    class="text-white text-sm font-bold font-mono"
                                    >{email}</span
                                >
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button
                                id="contact-copy-email-btn"
                                type="button"
                                data-email={email}
                                class="px-4 py-2.5 min-h-[44px] rounded-lg bg-zinc-800 hover:bg-zinc-700 text-zinc-200 hover:text-white text-xs font-semibold transition-colors flex items-center gap-1.5 cursor-pointer active:scale-[0.98]"
                                aria-label={copyEmailAria}
                            >
                                <Copy class="w-3.5 h-3.5 contact-copy-icon" />
                                <Check
                                    class="w-3.5 h-3.5 contact-check-icon hidden text-emerald-400"
                                />
                                <span class="contact-copy-label"
                                    >{t.contact.copyEmailBtn}</span
                                >
                            </button>

                            <a
                                href={`mailto:${email}?subject=Hola%20Gefy!`}
                                class="px-5 py-2.5 min-h-[44px] rounded-lg bg-gradient-to-r from-[#0db7b9] to-[#735ed5] hover:opacity-95 text-white font-semibold text-xs transition-opacity flex items-center gap-1.5 active:scale-[0.98]"
                            >
                                <Send class="w-3.5 h-3.5" />
                                <span>{t.contact.sendEmailBtn}</span>
                            </a>
                        </div>
                    </div>
                </div>
                <!--/email_off-->
            </div>

            <div class="lg:col-span-4 flex flex-col justify-between gap-4">
                <a
                    href="https://github.com/gefydev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-[#735ed5]/50 p-5 flex items-center justify-between transition-all duration-200 hover:-translate-y-0.5 shadow-md active:scale-[0.98]"
                    aria-label={githubAria}
                >
                    <div class="flex items-center gap-4">
                        <div
                            class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-200 group-hover:text-white group-hover:border-zinc-700 transition-colors"
                        >
                            <Github class="w-6 h-6" />
                        </div>
                        <div>
                            <p
                                class="text-base font-bold text-white group-hover:text-[#0db7b9] transition-colors"
                            >
                                GitHub
                            </p>
                            <p class="text-xs font-mono text-zinc-400">
                                @gefydev
                            </p>
                        </div>
                    </div>
                    <ArrowUpRight
                        class="w-5 h-5 text-zinc-600 group-hover:text-[#0db7b9] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
                    />
                </a>

                <a
                    href="https://linkedin.com/in/gefydev"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-[#0db7b9]/50 p-5 flex items-center justify-between transition-all duration-200 hover:-translate-y-0.5 shadow-md active:scale-[0.98]"
                    aria-label={linkedinAria}
                >
                    <div class="flex items-center gap-4">
                        <div
                            class="p-3 rounded-xl bg-zinc-900 border border-zinc-800 text-zinc-200 group-hover:text-white group-hover:border-zinc-700 transition-colors"
                        >
                            <Linkedin class="w-6 h-6" />
                        </div>
                        <div>
                            <p
                                class="text-base font-bold text-white group-hover:text-[#0db7b9] transition-colors"
                            >
                                LinkedIn
                            </p>
                            <p class="text-xs font-mono text-zinc-400">
                                /in/gefydev
                            </p>
                        </div>
                    </div>
                    <ArrowUpRight
                        class="w-5 h-5 text-zinc-600 group-hover:text-[#0db7b9] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
                    />
                </a>

                <div
                    class="rounded-2xl bg-gradient-to-br from-[#121524] to-zinc-950 border border-zinc-800 p-5 space-y-2"
                >
                    <div
                        class="flex items-center gap-2 text-xs font-semibold text-[#0db7b9]"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                        ></span>
                        <span
                            >{
                                lang === "es"
                                    ? "Disponibilidad"
                                    : "Availability"
                            }</span
                        >
                    </div>
                    <p class="text-xs text-zinc-300 leading-relaxed">
                        {
                            lang === "es"
                                ? "Disponible para colaboraciones en código abierto, proyectos de software y oportunidades laborales."
                                : "Open for open-source collaborations, software engineering projects, and employment opportunities."
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function initContact() {
        const copyBtn = document.getElementById("contact-copy-email-btn");
        if (!copyBtn || (copyBtn as HTMLElement).dataset.bound) return;
        (copyBtn as HTMLElement).dataset.bound = "true";

        const copyIcon = copyBtn.querySelector(".contact-copy-icon");
        const checkIcon = copyBtn.querySelector(".contact-check-icon");
        const copyLabel = copyBtn.querySelector(".contact-copy-label");

        copyBtn.addEventListener("click", () => {
            const email = copyBtn.getAttribute("data-email");
            if (!email) return;

            copyIcon?.classList.add("hidden");
            checkIcon?.classList.remove("hidden");
            if (copyLabel) copyLabel.textContent = "¡Copiado!";

            if (navigator.clipboard) {
                navigator.clipboard.writeText(email).catch(() => {});
            }

            setTimeout(() => {
                copyIcon?.classList.remove("hidden");
                checkIcon?.classList.add("hidden");
                if (copyLabel) {
                    copyLabel.textContent = copyBtn
                        .getAttribute("aria-label")
                        ?.includes("Copy")
                        ? "Copy Email"
                        : "Copiar Email";
                }
            }, 2500);
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initContact);
    } else {
        initContact();
    }
    document.addEventListener("astro:page-load", initContact);
</script>
