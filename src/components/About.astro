---
import { translations } from '../data/translations';
import { User, GraduationCap, MapPin, Award, CheckCircle2, Clock, BookOpen } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="about" class="py-24 border-t border-zinc-800/80 relative" aria-labelledby="about-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="space-y-3 mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-sans font-medium text-[#735ed5]">
        <User class="w-3.5 h-3.5" />
        <span>03 // {lang === 'es' ? 'TRAYECTORIA & FORMACIÓN' : 'EDUCATION & BIO'}</span>
      </div>
      <h2 id="about-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
        {t.about.sectionTitle}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base font-sans max-w-xl">
        {t.about.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 space-y-6 text-zinc-300 font-sans leading-relaxed text-sm sm:text-base">
        <p>
          {t.about.bioParagraph1}
        </p>
        <p>
          {t.about.bioParagraph2}
        </p>
        <p>
          {t.about.bioParagraph3}
        </p>

        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-zinc-800/80 text-center">
          <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-4">
            <p class="text-xl sm:text-2xl font-bold text-[#0db7b9] font-sans">Exactas UBA</p>
            <p class="text-xs text-zinc-400 mt-1 font-sans">{lang === 'es' ? 'Computación' : 'Comp Science'}</p>
          </div>

          <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-4">
            <p class="text-xl sm:text-2xl font-bold text-[#735ed5] font-sans">CNBA</p>
            <p class="text-xs text-zinc-400 mt-1 font-sans">{lang === 'es' ? 'Egresado' : 'Alumnus'}</p>
          </div>

          <div class="rounded-xl bg-zinc-900/60 border border-zinc-800 p-4">
            <p class="text-xl sm:text-2xl font-bold text-amber-400 font-sans">Rust & Astro</p>
            <p class="text-xs text-zinc-400 mt-1 font-sans">{lang === 'es' ? 'Ecosistema' : 'Core Stack'}</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 space-y-4 font-sans">
        <div class="rounded-2xl bg-gradient-to-br from-[#121524] to-zinc-950 border border-[#735ed5]/30 p-6 space-y-3 shadow-lg">
          <div class="flex items-start gap-3">
            <div class="p-2.5 rounded-xl bg-[#735ed5]/15 border border-[#735ed5]/30 text-purple-300 shrink-0">
              <GraduationCap class="w-5 h-5" />
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-white text-base">{t.about.universityDegree}</h3>
              </div>
              <p class="text-xs text-cyan-400 font-medium">{t.about.universitySchool}</p>
            </div>
          </div>
          
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{t.about.universityStatus}</span>
          </div>

          <p class="text-xs text-zinc-300 leading-relaxed pt-1">
            {t.about.universityDesc}
          </p>
        </div>

        <div class="rounded-2xl bg-zinc-950/80 border border-zinc-800 p-6 space-y-3 shadow-md">
          <div class="flex items-start gap-3">
            <div class="p-2.5 rounded-xl bg-[#0db7b9]/15 border border-[#0db7b9]/30 text-[#0db7b9] shrink-0">
              <BookOpen class="w-5 h-5" />
            </div>
            <div>
              <h3 class="font-bold text-white text-base">{t.about.highSchoolTitle}</h3>
              <p class="text-xs text-zinc-400 font-medium">{t.about.highSchoolSchool}</p>
            </div>
          </div>

          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#735ed5]/10 border border-[#735ed5]/30 text-purple-300">
            <CheckCircle2 class="w-3.5 h-3.5" />
            <span>{t.about.highSchoolStatus}</span>
          </div>

          <p class="text-xs text-zinc-300 leading-relaxed pt-1">
            {t.about.highSchoolDesc}
          </p>
        </div>

        <div class="rounded-xl bg-zinc-950/80 border border-zinc-800 p-4 flex items-center justify-between text-xs text-zinc-300">
          <span class="flex items-center gap-2 text-zinc-400">
            <Clock class="w-4 h-4 text-[#0db7b9]" />
            <span>{t.about.localTime}</span>
          </span>
          <span id="about-live-clock" class="text-white font-mono text-sm font-bold tabular-nums">--:--:--</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function updateAboutClock() {
    const el = document.getElementById('about-live-clock');
    if (!el) return;
    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('es-AR', {
        timeZone: 'America/Argentina/Buenos_Aires',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      el.textContent = formatter.format(now);
    } catch {
      el.textContent = new Date().toLocaleTimeString();
    }
  }
  updateAboutClock();
  setInterval(updateAboutClock, 1000);
</script>
