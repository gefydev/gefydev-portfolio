---
import { translations } from "../data/translations";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

const approach =
    lang === "es"
        ? [
              "Sistemas deterministas y tipados estrictos",
              "Zero-bloat, rendimiento medido en milisegundos",
              "Interfaces accesibles, táctiles y fluidas",
          ]
        : [
              "Deterministic systems & strict typing",
              "Zero-bloat, sub-millisecond execution",
              "Accessible, tactile & fluid interfaces",
          ];
---

<section id="about" class="section section-cv" aria-labelledby="about-title">
    <div class="wrap">
        <div class="section-head">
            <h2 id="about-title">{t.about.sectionTitle}</h2>
            <p class="sub">{t.about.sectionSubtitle}</p>
        </div>

        <div class="prose">
            <p>{t.about.bioParagraph1}</p>
            <p>{t.about.bioParagraph2}</p>
            <p>{t.about.bioParagraph3}</p>
        </div>

        <dl class="facts">
            <div>
                <dt>{t.about.universityTitle}</dt>
                <dd>
                    <p class="strong">{t.about.universityDegree}</p>
                    <p class="small">{t.about.universitySchool}</p>
                    <p class="mono">{t.about.universityStatus}</p>
                    <p class="small">{t.about.universityDesc}</p>
                </dd>
            </div>
            <div>
                <dt>{t.about.highSchoolTitle}</dt>
                <dd>
                    <p class="strong">{t.about.highSchoolSchool}</p>
                    <p class="mono">{t.about.highSchoolStatus}</p>
                    <p class="small">{t.about.highSchoolDesc}</p>
                </dd>
            </div>
            <div>
                <dt>{t.about.locationTitle}</dt>
                <dd>
                    <p class="strong">{t.about.locationCity}</p>
                    <p class="small">
                        {t.about.localTime}
                        <span id="about-live-clock" class="clock">--:--:--</span>
                    </p>
                </dd>
            </div>
            <div>
                <dt>philosophy.rs</dt>
                <dd>
<pre class="code" tabindex="0"><code>struct Developer &#123;
  name: &amp;'static str,
  university: &amp;'static str,
  focus: Vec&lt;&amp;'static str&gt;,
&#125;

impl Developer &#123;
  fn new() -&gt; Self &#123;
    Self &#123;
      name: "Gena (GefyDev)",
      university: "UBA Exactas (CS)",
      focus: vec![
        "Web Performance",
        "Systems Architecture",
        "High-Precision UI",
      ],
    &#125;
  &#125;
&#125;</code></pre>
                    <p class="approach">
                        // {lang === "es" ? "Enfoque de ingeniería:" : "Engineering approach:"}
                    </p>
                    <ul class="approach-list">
                        {approach.map((item) => <li>{item}</li>)}
                    </ul>
                </dd>
            </div>
        </dl>
    </div>
</section>
