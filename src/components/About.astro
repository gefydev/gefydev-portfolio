---
import { translations } from "../data/translations";
import {
    User,
    GraduationCap,
    School,
    Code2,
    CheckCircle2,
    Clock,
    BookOpen,
    Sparkles,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section
    id="about"
    class="py-24 border-t border-zinc-800/80 relative font-sans"
    aria-labelledby="about-title"
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="space-y-3 mb-12">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono font-semibold tracking-wider uppercase text-purple-300"
            >
                <User class="w-3.5 h-3.5" />
                <span
                    >03 // {
                        lang === "es"
                            ? "TRAYECTORIA & FORMACIÓN"
                            : "EDUCATION & BIO"
                    }</span
                >
            </div>
            <h2
                id="about-title"
                class="text-3xl sm:text-4xl font-bold tracking-tight text-white"
            >
                {t.about.sectionTitle}
            </h2>
            <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
                {t.about.sectionSubtitle}
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div
                class="lg:col-span-7 space-y-6 text-zinc-300 leading-relaxed text-sm sm:text-base"
            >
                <p>
                    {t.about.bioParagraph1}
                </p>
                <p>
                    {t.about.bioParagraph2}
                </p>
                <p>
                    {t.about.bioParagraph3}
                </p>

                <!-- Bento Stat Grid (Uniform styling & vertically centered) -->
                <div
                    class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-6 border-t border-zinc-800/80"
                >
                    <!-- Card 1: UBA Exactas -->
                    <div
                        class="group relative rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-[#0db7b9]/50 p-4 sm:p-5 flex flex-col items-center justify-center text-center transition-all duration-300 hover:-translate-y-0.5 shadow-md h-full min-h-[160px]"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-[#0db7b9]/15 border border-[#0db7b9]/30 text-[#0db7b9] flex items-center justify-center mb-2.5 transition-transform duration-300 group-hover:scale-110 shrink-0"
                        >
                            <GraduationCap class="w-4 h-4" />
                        </div>
                        <p
                            class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug"
                        >
                            {
                                lang === "es"
                                    ? "Univ. de Buenos Aires"
                                    : "Univ. of Buenos Aires"
                            }
                        </p>
                        <p class="text-xs text-zinc-400 font-mono mt-1">
                            {
                                lang === "es"
                                    ? "Exactas (Computación)"
                                    : "Computer Science (FCEN)"
                            }
                        </p>
                        <span
                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#0db7b9]/10 border border-[#0db7b9]/25 text-cyan-300 mt-2.5"
                        >
                            <span
                                class="w-1.5 h-1.5 rounded-full bg-[#0db7b9] animate-pulse"
                            ></span>
                            <span
                                >{
                                    lang === "es" ? "En curso" : "Undergraduate"
                                }</span
                            >
                        </span>
                    </div>

                    <!-- Card 2: CNBA -->
                    <div
                        class="group relative rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-purple-500/50 p-4 sm:p-5 flex flex-col items-center justify-center text-center transition-all duration-300 hover:-translate-y-0.5 shadow-md h-full min-h-[160px]"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-[#735ed5]/15 border border-[#735ed5]/30 text-purple-300 flex items-center justify-center mb-2.5 transition-transform duration-300 group-hover:scale-110 shrink-0"
                        >
                            <School class="w-4 h-4" />
                        </div>
                        <p
                            class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors leading-snug"
                        >
                            CNBA
                        </p>
                        <p class="text-xs text-zinc-400 font-mono mt-1">
                            {
                                lang === "es"
                                    ? "Col. Nac. Buenos Aires"
                                    : "Col. Nac. Buenos Aires"
                            }
                        </p>
                        <span
                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-[#735ed5]/10 border border-[#735ed5]/25 text-purple-300 mt-2.5"
                        >
                            <Sparkles class="w-2.5 h-2.5" />
                            <span>{lang === "es" ? "Egresado" : "Alumnus"}</span
                            >
                        </span>
                    </div>

                    <!-- Card 3: Core Stack -->
                    <div
                        class="group relative rounded-2xl bg-zinc-950/80 border border-zinc-800 hover:border-cyan-500/50 p-4 sm:p-5 flex flex-col items-center justify-center text-center transition-all duration-300 hover:-translate-y-0.5 shadow-md h-full min-h-[160px]"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-cyan-500/15 border border-cyan-500/30 text-cyan-400 flex items-center justify-center mb-2.5 transition-transform duration-300 group-hover:scale-110 shrink-0"
                        >
                            <Code2 class="w-4 h-4" />
                        </div>
                        <p
                            class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors leading-snug"
                        >
                            TypeScript & React
                        </p>
                        <p class="text-xs text-zinc-400 font-mono mt-1">
                            {
                                lang === "es"
                                    ? "Full-Stack & Web"
                                    : "Full-Stack & Web"
                            }
                        </p>
                        <span
                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-mono font-medium bg-cyan-500/10 border border-cyan-500/25 text-cyan-300 mt-2.5"
                        >
                            <Sparkles class="w-2.5 h-2.5" />
                            <span
                                >{
                                    lang === "es"
                                        ? "Stack Principal"
                                        : "Core Stack"
                                }</span
                            >
                        </span>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-5 space-y-4">
                <div
                    class="rounded-2xl bg-gradient-to-br from-[#121524] to-zinc-950 border border-[#735ed5]/30 p-6 space-y-3 shadow-lg"
                >
                    <div class="flex items-start gap-3">
                        <div
                            class="p-2.5 rounded-xl bg-[#735ed5]/15 border border-[#735ed5]/30 text-purple-300 shrink-0"
                        >
                            <GraduationCap class="w-5 h-5" />
                        </div>
                        <div>
                            <h3 class="font-bold text-white text-base">
                                {t.about.universityDegree}
                            </h3>
                            <p class="text-xs text-cyan-400 font-medium">
                                {t.about.universitySchool}
                            </p>
                        </div>
                    </div>

                    <div
                        class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"
                        ></span>
                        <span>{t.about.universityStatus}</span>
                    </div>

                    <p class="text-xs text-zinc-300 leading-relaxed pt-1">
                        {t.about.universityDesc}
                    </p>
                </div>

                <div
                    class="rounded-2xl bg-zinc-950/80 border border-zinc-800 p-6 space-y-3 shadow-md"
                >
                    <div class="flex items-start gap-3">
                        <div
                            class="p-2.5 rounded-xl bg-[#0db7b9]/15 border border-[#0db7b9]/30 text-[#0db7b9] shrink-0"
                        >
                            <BookOpen class="w-5 h-5" />
                        </div>
                        <div>
                            <h3 class="font-bold text-white text-base">
                                {t.about.highSchoolTitle}
                            </h3>
                            <p class="text-xs text-zinc-400 font-medium">
                                {t.about.highSchoolSchool}
                            </p>
                        </div>
                    </div>

                    <div
                        class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#735ed5]/10 border border-[#735ed5]/30 text-purple-300"
                    >
                        <CheckCircle2 class="w-3.5 h-3.5" />
                        <span>{t.about.highSchoolStatus}</span>
                    </div>

                    <p class="text-xs text-zinc-300 leading-relaxed pt-1">
                        {t.about.highSchoolDesc}
                    </p>
                </div>

                <div
                    class="rounded-xl bg-zinc-950/80 border border-zinc-800 p-4 flex items-center justify-between text-xs text-zinc-300"
                >
                    <span class="flex items-center gap-2 text-zinc-400">
                        <Clock class="w-4 h-4 text-[#0db7b9]" />
                        <span>{t.about.localTime}</span>
                    </span>
                    <span
                        id="about-live-clock"
                        class="text-white font-mono text-sm font-bold tabular-nums"
                        >--:--:--</span
                    >
                </div>
            </div>
        </div>
    </div>
</section>
