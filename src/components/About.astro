---
import { translations } from "../data/translations";
import {
    User,
    GraduationCap,
    School,
    Code2,
    CheckCircle2,
    Clock,
    BookOpen,
    Sparkles,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section
    id="about"
    class="py-24 border-t border-zinc-800/80 relative font-sans section-cv"
    aria-labelledby="about-title"
>
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="space-y-3 mb-12">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono font-semibold tracking-wider uppercase text-purple-300"
            >
                <User class="w-3.5 h-3.5" />
                <span
                    >03 // {
                        lang === "es"
                            ? "TRAYECTORIA & FORMACIÓN"
                            : "EDUCATION & BIO"
                    }</span
                >
            </div>
            <h2
                id="about-title"
                class="text-3xl sm:text-4xl font-bold tracking-tight text-white"
            >
                {t.about.sectionTitle}
            </h2>
            <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
                {t.about.sectionSubtitle}
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <div
                class="lg:col-span-7 space-y-6 text-zinc-300 leading-relaxed text-sm sm:text-base"
            >
                <p>
                    {t.about.bioParagraph1}
                </p>
                <p>
                    {t.about.bioParagraph2}
                </p>
                <p>
                    {t.about.bioParagraph3}
                </p>

                <!-- Bento Stat Grid (Uniform styling & vertically centered) -->
                <div
                    class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-6 border-t border-zinc-800/80"
                >
                    <!-- Card 1: UBA Exactas -->
                    <div
                        class="min-h-[160px] rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-teal-500/40 p-5 flex flex-col justify-center items-center text-center gap-2.5 transition-all duration-300 hover:-translate-y-1 shadow-md group"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-[#0db7b9] group-hover:scale-110 transition-transform duration-300 shrink-0"
                        >
                            <GraduationCap class="w-5 h-5" />
                        </div>
                        <div class="space-y-1 w-full">
                            <p
                                class="text-sm font-bold text-white leading-snug font-sans"
                            >
                                {
                                    lang === "es"
                                        ? "Univ. de Buenos Aires"
                                        : "Univ. of Buenos Aires"
                                }
                            </p>
                            <p
                                class="text-xs text-zinc-400 font-medium font-sans"
                            >
                                {
                                    lang === "es"
                                        ? "Ciencias de la Computación"
                                        : "Computer Science"
                                }
                            </p>
                        </div>
                        <span
                            class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400"
                        >
                            <span
                                class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"
                            ></span>
                            {
                                lang === "es"
                                    ? "En curso (Exactas)"
                                    : "In Progress (Exactas)"
                            }
                        </span>
                    </div>

                    <!-- Card 2: CNBA -->
                    <div
                        class="min-h-[160px] rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-purple-500/40 p-5 flex flex-col justify-center items-center text-center gap-2.5 transition-all duration-300 hover:-translate-y-1 shadow-md group"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform duration-300 shrink-0"
                        >
                            <School class="w-5 h-5" />
                        </div>
                        <div class="space-y-1 w-full">
                            <p
                                class="text-sm font-bold text-white leading-snug font-sans"
                            >
                                {
                                    lang === "es"
                                        ? "Col. Nac. de Buenos Aires"
                                        : "CNBA High School"
                                }
                            </p>
                            <p
                                class="text-xs text-zinc-400 font-medium font-sans"
                            >
                                {
                                    lang === "es"
                                        ? "Bachiller Graduado"
                                        : "High School Graduate"
                                }
                            </p>
                        </div>
                        <span
                            class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-purple-500/10 border border-purple-500/30 text-purple-300"
                        >
                            <CheckCircle2 class="w-3 h-3 text-purple-400" />
                            {lang === "es" ? "Graduado CNBA" : "CNBA Alum"}
                        </span>
                    </div>

                    <!-- Card 3: Core Web Stack -->
                    <div
                        class="min-h-[160px] rounded-2xl bg-zinc-950/90 border border-zinc-800/90 hover:border-cyan-500/40 p-5 flex flex-col justify-center items-center text-center gap-2.5 transition-all duration-300 hover:-translate-y-1 shadow-md group"
                    >
                        <div
                            class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 group-hover:scale-110 transition-transform duration-300 shrink-0"
                        >
                            <Code2 class="w-5 h-5" />
                        </div>
                        <div class="space-y-1 w-full">
                            <p
                                class="text-sm font-bold text-white leading-snug font-sans"
                            >
                                {
                                    lang === "es"
                                        ? "Core Web Stack"
                                        : "Core Web Stack"
                                }
                            </p>
                            <p
                                class="text-xs text-zinc-400 font-medium font-sans"
                            >
                                TypeScript & Rust
                            </p>
                        </div>
                        <span
                            class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-cyan-500/10 border border-cyan-500/30 text-cyan-300"
                        >
                            <Sparkles class="w-3 h-3 text-cyan-400" />
                            {
                                lang === "es"
                                    ? "Alto Rendimiento"
                                    : "High Performance"
                            }
                        </span>
                    </div>
                </div>
            </div>

            <!-- Terminal / Code Philosophy Block -->
            <div
                class="lg:col-span-5 rounded-2xl bg-zinc-950/90 border border-zinc-800 p-6 space-y-5 shadow-2xl relative overflow-hidden"
            >
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500/80"
                        ></span>
                        <span class="w-3 h-3 rounded-full bg-green-500/80"
                        ></span>
                    </div>
                    <span class="text-xs font-mono text-zinc-500"
                        >philosophy.rs</span
                    >
                </div>

                <pre
                    class="font-mono text-xs text-zinc-300 leading-relaxed overflow-x-auto p-4 rounded-xl bg-zinc-900/60 border border-zinc-800/80"><code><span class="text-[#0db7b9]">struct</span> <span class="text-purple-300">Developer</span> &#123;
  name: <span class="text-emerald-400">&amp;'static str</span>,
  university: <span class="text-emerald-400">&amp;'static str</span>,
  focus: <span class="text-emerald-400">Vec&lt;&amp;'static str&gt;</span>,
&#125;

<span class="text-[#0db7b9]">impl</span> <span class="text-purple-300">Developer</span> &#123;
  <span class="text-[#0db7b9]">fn</span> <span class="text-amber-300">new</span>() -&gt; <span class="text-[#0db7b9]">Self</span> &#123;
    <span class="text-[#0db7b9]">Self</span> &#123;
      name: <span class="text-emerald-400">"Gena (GefyDev)"</span>,
      university: <span class="text-emerald-400">"UBA Exactas (CS)"</span>,
      focus: <span class="text-[#0db7b9]">vec!</span>[
        <span class="text-emerald-400">"Web Performance"</span>,
        <span class="text-emerald-400">"Systems Architecture"</span>,
        <span class="text-emerald-400">"High-Precision UI"</span>,
      ],
    &#125;
  &#125;
&#125;</code></pre>

                <div class="space-y-3 pt-2">
                    <p class="text-xs text-zinc-400 font-mono">
                        // {
                            lang === "es"
                                ? "Enfoque de ingeniería:"
                                : "Engineering approach:"
                        }
                    </p>
                    <ul class="text-xs text-zinc-300 space-y-2 font-mono">
                        <li class="flex items-center gap-2">
                            <span class="text-[#0db7b9]">→</span>
                            <span
                                >{
                                    lang === "es"
                                        ? "Sistemas deterministas y tipados estrictos"
                                        : "Deterministic systems & strict typing"
                                }</span
                            >
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-purple-400">→</span>
                            <span
                                >{
                                    lang === "es"
                                        ? "Zero-bloat, rendimiento medido en milisegundos"
                                        : "Zero-bloat, sub-millisecond execution"
                                }</span
                            >
                        </li>
                        <li class="flex items-center gap-2">
                            <span class="text-emerald-400">→</span>
                            <span
                                >{
                                    lang === "es"
                                        ? "Interfaces accesibles, táctiles y fluidas"
                                        : "Accessible, tactile & fluid interfaces"
                                }</span
                            >
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
