---
import { translations } from "../data/translations";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

const copyCmdAria =
    lang === "es" ? "Copiar comando npx gefydev" : "Copy command npx gefydev";
---

<section id="hero" class="hero" aria-label="Hero">
    <div class="wrap">
        <h1>
            <span class="greet">{t.hero.greeting}</span>
            <span>{t.hero.name}</span>
        </h1>
        <p class="role">{t.hero.roleTitle}</p>
        <p class="byline">{t.hero.badge}</p>
        <p class="lead">{t.hero.subtitle}</p>

        <div class="actions">
            <a href="#projects" class="btn">
                <span>{t.hero.exploreProjects}</span>
                <span aria-hidden="true">→</span>
            </a>
            <a href="#contact" class="btn btn-ghost">
                <span>{t.hero.contactMe}</span>
            </a>
        </div>

        <div class="cmdrow">
            <div class="cmd">
                <span class="prompt" aria-hidden="true">$</span>
                <code id="hero-cmd-text">npx gefydev</code>
                <button
                    id="hero-copy-cmd"
                    type="button"
                    aria-label={copyCmdAria}
                >
                    <span class="copy-label"
                        >{lang === "es" ? "Copiar" : "Copy"}</span
                    >
                </button>
            </div>
            <span class="status">{t.hero.availableBadge}</span>
        </div>
    </div>
</section>

<script>
    function initHero() {
        const copyBtn = document.getElementById("hero-copy-cmd");
        if (!copyBtn || copyBtn.dataset.bound) return;
        copyBtn.dataset.bound = "true";

        const copyLabel = copyBtn.querySelector(".copy-label");

        copyBtn.addEventListener("click", () => {
            try {
                copyBtn.classList.add("copied");
                if (copyLabel) copyLabel.textContent = "¡Listo!";

                if (navigator.clipboard) {
                    navigator.clipboard
                        .writeText("npx gefydev")
                        .catch(() => {});
                }

                setTimeout(() => {
                    copyBtn.classList.remove("copied");
                    if (copyLabel) {
                        copyLabel.textContent = copyBtn
                            .getAttribute("aria-label")
                            ?.includes("Copy")
                            ? "Copy"
                            : "Copiar";
                    }
                }, 2500);
            } catch {}
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initHero);
    } else {
        initHero();
    }
    document.addEventListener("astro:page-load", initHero);
</script>
