---
import { projects } from '../data/projects';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  lang: 'es' | 'en';
  canonicalUrl?: string;
  image?: string;
  noindex?: boolean;
}

const siteUrl = 'https://gefy.dev';
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const computedCanonical = pathname === '' ? `${siteUrl}/` : `${siteUrl}${pathname}`;

const {
  title,
  description,
  keywords = 'GefyDev, Genaro Febbo Yapur, Desarrollador Web, Rust, Astro, TypeScript, Ciencias de la Computacion, Exactas UBA, CNBA, Buenos Aires, Portfolio',
  lang,
  canonicalUrl = computedCanonical,
  image = `${siteUrl}/og-image.png`,
  noindex = false,
} = Astro.props;

const esUrl = `${siteUrl}/es`;
const enUrl = `${siteUrl}/en`;
const ogLocale = lang === 'es' ? 'es_AR' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_AR';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Genaro Febbo Yapur',
    alternateName: ['GefyDev', 'Genaro Febbo', 'Gefy'],
    givenName: 'Genaro',
    familyName: 'Febbo Yapur',
    url: siteUrl,
    jobTitle: lang === 'es' ? 'Desarrollador Full-Stack & Sistemas' : 'Full-Stack & Systems Software Developer',
    description: description,
    image: `${siteUrl}/logo-white-bg.png`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Buenos Aires',
      addressCountry: 'AR',
    },
    alumniOf: {
      '@type': 'EducationalOrganization',
      name: 'Colegio Nacional de Buenos Aires',
      alternateName: 'CNBA',
      url: 'https://cnba.uba.ar',
    },
    affiliation: {
      '@type': 'EducationalOrganization',
      name: 'Facultad de Ciencias Exactas y Naturales (FCEyN)',
      alternateName: 'Exactas UBA',
      url: 'https://exactas.uba.ar',
      parentOrganization: {
        '@type': 'EducationalOrganization',
        name: 'Universidad de Buenos Aires',
        alternateName: 'UBA',
        url: 'https://www.uba.ar',
      },
    },
    sameAs: [
      'https://github.com/gefydev',
    ],
    knowsAbout: [
      'Rust',
      'TypeScript',
      'JavaScript',
      'Astro',
      'React',
      'Node.js',
      'Computer Science',
      'Data Structures & Algorithms',
      'Tailwind CSS',
      'Linux',
      'Web Performance',
      'Search Engine Optimization (SEO)',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${siteUrl}/#profile`,
    url: canonicalUrl,
    name: title,
    isPartOf: {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: 'GefyDev Portfolio',
      description: description,
      inLanguage: ['es', 'en'],
    },
    mainEntity: {
      '@id': `${siteUrl}/#person`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: lang === 'es' ? 'Proyectos de Software de GefyDev' : 'Software Projects by GefyDev',
    itemListElement: projects.map((project, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'SoftwareApplication',
        name: project.name,
        url: project.homepageUrl || project.githubUrl,
        description: project.description[lang],
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Any',
        codeRepository: project.githubUrl,
        author: {
          '@id': `${siteUrl}/#person`,
        },
      },
    })),
  },
];
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="Genaro Febbo Yapur (GefyDev)" />
<meta name="creator" content="GefyDev" />
<meta name="publisher" content="Genaro Febbo Yapur" />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  </>
)}

<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="es" href={esUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="help" type="text/plain" href="/llms.txt" />

<meta property="og:type" content="profile" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content="GefyDev — Developer Portfolio" />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="GefyDev (Genaro Febbo Yapur) — Full-Stack & Systems Developer" />
<meta property="og:locale" content={ogLocale} />
<meta property="og:locale:alternate" content={ogLocaleAlt} />
<meta property="profile:first_name" content="Genaro" />
<meta property="profile:last_name" content="Febbo Yapur" />
<meta property="profile:username" content="gefydev" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content="GefyDev (Genaro Febbo Yapur) — Full-Stack & Systems Developer" />

<meta name="theme-color" content="#06070b" />
<meta name="color-scheme" content="dark" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

{structuredData.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
