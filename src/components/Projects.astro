---
import { projects, openSourceContributions } from '../data/projects';
import { translations } from '../data/translations';
import ProjectCard from './ProjectCard.astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="projects" class="section section-cv" aria-labelledby="projects-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="projects-title">{t.projects.sectionTitle}</h2>
      <p class="sub">{t.projects.sectionSubtitle}</p>
    </div>

    <div
      class="tabs"
      role="tablist"
      aria-label={lang === 'es' ? 'Filtros de proyectos' : 'Project category filters'}
    >
        <button
          type="button"
          class="project-filter-btn tab"
          data-filter="all"
          role="tab"
          aria-selected="true"
          tabindex="0"
        >
          {t.projects.filterAll}
        </button>
        <button
          type="button"
          class="project-filter-btn tab"
          data-filter="rust"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterRust}
        </button>
        <button
          type="button"
          class="project-filter-btn tab"
          data-filter="astro"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterAstro}
        </button>
        <button
          type="button"
          class="project-filter-btn tab"
          data-filter="web"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterWeb}
        </button>
    </div>

    <ol id="projects-bento-grid">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </ol>
  </div>
</section>

<section id="contributions" class="section section-cv" aria-labelledby="contributions-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="contributions-title">{t.projects.contributionsTitle}</h2>
      <p class="sub">{t.projects.contributionsSubtitle}</p>
    </div>

    <ol>
      {openSourceContributions.map((item) => (
        <li class="contrib">
          <div>
            <p class="contrib-name">{item.author} / {item.repo}</p>
            <p class="meta">
              {item.role[lang]}
              {item.prsCount && <> · {item.prsCount} {lang === 'es' ? 'PRs fusionadas' : 'PRs merged'}</>}
              · ★ {item.stars} stars
            </p>
            <p class="pdesc">{item.description[lang]}</p>
            <p class="tags">
              {item.techTags.map((tag) => <span>{tag.name}</span>)}
            </p>
            <div class="links">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link ext"
                aria-label={lang === 'es' ? `Ver repositorio ${item.repo} en GitHub` : `View ${item.repo} repository on GitHub`}
              >
                {lang === 'es' ? 'Ver en GitHub' : 'View on GitHub'}
              </a>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  function initProjects() {
    const filterContainer = document.querySelector('[role="tablist"]');
    if (!filterContainer || (filterContainer as HTMLElement).dataset.bound) return;
    (filterContainer as HTMLElement).dataset.bound = 'true';

    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.project-filter-btn'));
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('.project-item'));

    function setActiveTab(activeBtn: HTMLButtonElement) {
      const filter = activeBtn.getAttribute('data-filter') || 'all';

      filterBtns.forEach((b) => {
        const isSelected = b === activeBtn;
        b.setAttribute('aria-selected', String(isSelected));
        b.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      projectCards.forEach((item) => {
        const category = item.getAttribute('data-category');
        const isVisible = filter === 'all' || category === filter;
        item.hidden = !isVisible;
      });
    }

    filterBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => setActiveTab(btn));

      btn.addEventListener('keydown', (e) => {
        let nextIndex = index;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (index + 1) % filterBtns.length;
          setActiveTab(filterBtns[nextIndex]);
          filterBtns[nextIndex].focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (index - 1 + filterBtns.length) % filterBtns.length;
          setActiveTab(filterBtns[nextIndex]);
          filterBtns[nextIndex].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          setActiveTab(filterBtns[0]);
          filterBtns[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          setActiveTab(filterBtns[filterBtns.length - 1]);
          filterBtns[filterBtns.length - 1].focus();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
  document.addEventListener('astro:page-load', initProjects);
</script>
