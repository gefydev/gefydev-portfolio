---
import { projects, openSourceContributions } from "../data/projects";
import { translations } from "../data/translations";
import ProjectCard from "./ProjectCard.astro";
import {
    FolderGit2,
    GitPullRequest,
    Star,
    ExternalLink,
    Github,
    Sparkles,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];

// Default asymmetric layout spans for all 5 projects
const defaultSpans = [
    "col-span-12 md:col-span-7", // 0: Spotifust
    "col-span-12 md:col-span-5", // 1: ComiDólar
    "col-span-12 md:col-span-5", // 2: GenaCleaner
    "col-span-12 md:col-span-7", // 3: 412 Stream
    "col-span-12 md:col-span-12", // 4: BlackMaps
];
---

<section
    id="projects"
    class="py-24 border-t border-zinc-800/80 relative font-sans"
    aria-labelledby="projects-title"
>
    <!-- Subtle ambient glow -->
    <div
        class="absolute top-0 right-1/4 w-96 h-96 bg-[#0db7b9]/5 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
        <div
            class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12"
        >
            <div class="space-y-3">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-[#0db7b9]"
                >
                    <FolderGit2 class="w-3.5 h-3.5" />
                    <span class="font-bold"
                        >01. // {
                            lang === "es"
                                ? "PROYECTOS & SHOWCASE"
                                : "PROJECTS & SHOWCASE"
                        }</span
                    >
                </div>
                <h2
                    id="projects-title"
                    class="text-3xl sm:text-4xl font-bold tracking-tight text-white"
                >
                    {t.projects.sectionTitle}
                </h2>
                <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
                    {t.projects.sectionSubtitle}
                </p>
            </div>

            <!-- Filter Tabs -->
            <div
                class="flex flex-wrap items-center gap-1.5 p-1.5 rounded-xl bg-zinc-900/90 border border-zinc-800 text-xs"
                role="tablist"
                aria-label={lang === "es"
                    ? "Filtros de proyectos"
                    : "Project category filters"}
            >
                <button
                    type="button"
                    class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg bg-[#0db7b9] text-zinc-950 font-bold transition-all cursor-pointer active:scale-[0.98]"
                    data-filter="all"
                    role="tab"
                    aria-selected="true"
                    tabindex="0"
                >
                    {t.projects.filterAll}
                </button>
                <button
                    type="button"
                    class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium active:scale-[0.98]"
                    data-filter="rust"
                    role="tab"
                    aria-selected="false"
                    tabindex="-1"
                >
                    {t.projects.filterRust}
                </button>
                <button
                    type="button"
                    class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium active:scale-[0.98]"
                    data-filter="astro"
                    role="tab"
                    aria-selected="false"
                    tabindex="-1"
                >
                    {t.projects.filterAstro}
                </button>
                <button
                    type="button"
                    class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium active:scale-[0.98]"
                    data-filter="web"
                    role="tab"
                    aria-selected="false"
                    tabindex="-1"
                >
                    {t.projects.filterWeb}
                </button>
            </div>
        </div>

        <!-- Asymmetric Projects Bento Grid with Spotlight Tracking -->
        <div
            id="projects-bento-grid"
            class="grid grid-cols-1 md:grid-cols-12 gap-5 sm:gap-6 mb-16"
        >
            {
                projects.map((project, index) => (
                    <ProjectCard
                        project={project}
                        lang={lang}
                        defaultSpan={
                            defaultSpans[index] || "col-span-12 md:col-span-6"
                        }
                    />
                ))
            }
        </div>

        <!-- Open Source Contributions Deck -->
        <div
            id="contributions"
            class="pt-8 border-t border-zinc-800/80 space-y-6"
        >
            <div class="space-y-2">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#735ed5]/10 border border-[#735ed5]/30 text-xs font-mono font-semibold text-purple-300"
                >
                    <GitPullRequest class="w-3.5 h-3.5" />
                    <span>OPEN SOURCE CONTRIBUTIONS</span>
                </div>
                <h3 class="text-2xl font-bold text-white">
                    {t.projects.contributionsTitle}
                </h3>
                <p class="text-zinc-400 text-sm max-w-xl">
                    {t.projects.contributionsSubtitle}
                </p>
            </div>

            <div class="grid grid-cols-1 gap-4">
                {
                    openSourceContributions.map((item) => (
                        <div class="rounded-2xl bg-gradient-to-r from-zinc-950 via-[#0d101a] to-zinc-950 border border-zinc-800/90 hover:border-zinc-700 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl transition-all duration-300">
                            <div class="space-y-3 max-w-2xl">
                                <div class="flex flex-wrap items-center gap-3">
                                    <span class="text-xl font-bold text-white font-mono">
                                        {item.author} /{" "}
                                        <span class="text-[#0db7b9]">
                                            {item.repo}
                                        </span>
                                    </span>
                                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                                        <Sparkles class="w-3 h-3" />
                                        <span>{item.role[lang]}</span>
                                    </span>
                                    {item.prsCount && (
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-500/10 border border-purple-500/30 text-purple-300 font-mono">
                                            <GitPullRequest class="w-3.5 h-3.5 text-purple-400" />
                                            <span>
                                                {item.prsCount}{" "}
                                                {lang === "es"
                                                    ? "PRs fusionadas"
                                                    : "PRs merged"}
                                            </span>
                                        </span>
                                    )}
                                    <span class="flex items-center gap-1 text-xs font-mono text-amber-400">
                                        <Star class="w-3.5 h-3.5 fill-amber-400/30" />
                                        <span>{item.stars} stars</span>
                                    </span>
                                </div>

                                <p class="text-sm text-zinc-300 leading-relaxed font-sans">
                                    {item.description[lang]}
                                </p>

                                <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
                                    {item.techTags.map((tag) => (
                                        <span
                                            class="px-2.5 py-0.5 rounded-md border"
                                            style={`color: ${tag.color}; background-color: ${tag.bg}; border-color: ${tag.border};`}
                                        >
                                            {tag.name}
                                        </span>
                                    ))}
                                </div>
                            </div>

                            <div class="shrink-0 flex items-center gap-3">
                                <a
                                    href={item.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-white text-xs font-semibold transition-colors active:scale-[0.98]"
                                    aria-label={
                                        lang === "es"
                                            ? `Ver repositorio ${item.repo} en GitHub`
                                            : `View ${item.repo} repository on GitHub`
                                    }
                                >
                                    <Github class="w-4 h-4" />
                                    <span>
                                        {lang === "es"
                                            ? "Ver en GitHub"
                                            : "View on GitHub"}
                                    </span>
                                    <ExternalLink class="w-3.5 h-3.5 text-zinc-400" />
                                </a>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<script>
    function initProjects() {
        const filterContainer = document.querySelector('[role="tablist"]');
        if (!filterContainer || (filterContainer as HTMLElement).dataset.bound)
            return;
        (filterContainer as HTMLElement).dataset.bound = "true";

        const filterBtns = Array.from(
            document.querySelectorAll<HTMLButtonElement>(".project-filter-btn"),
        );
        const projectCards = Array.from(
            document.querySelectorAll<HTMLElement>(".bento-project-card"),
        );
        const grid = document.getElementById("projects-bento-grid");

        // Setup Spotlight mouse tracking on projects grid
        let rafId: number | null = null;
        function handleMouseMove(e: MouseEvent) {
            if (rafId) cancelAnimationFrame(rafId);
            rafId = requestAnimationFrame(() => {
                projectCards.forEach((card) => {
                    if (card.style.display === "none") return;
                    const rect = card.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    card.style.setProperty("--mouse-x", `${x}px`);
                    card.style.setProperty("--mouse-y", `${y}px`);
                });
            });
        }

        grid?.addEventListener("mousemove", handleMouseMove, { passive: true });

        // Dynamic Asymmetric Bento layout distributor
        function rebalanceBentoLayout(visibleCards: HTMLElement[]) {
            const count = visibleCards.length;

            visibleCards.forEach((card, index) => {
                // Remove old span classes
                card.classList.remove(
                    "md:col-span-5",
                    "md:col-span-6",
                    "md:col-span-7",
                    "md:col-span-12",
                );

                if (count === 1) {
                    // Single item takes full row
                    card.classList.add("md:col-span-12");
                } else if (count === 2) {
                    // 2 items: 7 cols + 5 cols
                    card.classList.add(
                        index === 0 ? "md:col-span-7" : "md:col-span-5",
                    );
                } else if (count === 3) {
                    // 3 items: 7 + 5 on row 1, 12 on row 2
                    if (index === 0) card.classList.add("md:col-span-7");
                    else if (index === 1) card.classList.add("md:col-span-5");
                    else card.classList.add("md:col-span-12");
                } else if (count === 4) {
                    // 4 items: 7 + 5 on row 1, 5 + 7 on row 2
                    if (index === 0) card.classList.add("md:col-span-7");
                    else if (index === 1) card.classList.add("md:col-span-5");
                    else if (index === 2) card.classList.add("md:col-span-5");
                    else card.classList.add("md:col-span-7");
                } else {
                    // 5+ items: 7 + 5, 5 + 7, 12...
                    if (index === 0) card.classList.add("md:col-span-7");
                    else if (index === 1) card.classList.add("md:col-span-5");
                    else if (index === 2) card.classList.add("md:col-span-5");
                    else if (index === 3) card.classList.add("md:col-span-7");
                    else card.classList.add("md:col-span-12");
                }
            });
        }

        function setActiveTab(selectedBtn: HTMLButtonElement) {
            const filter = selectedBtn.getAttribute("data-filter");

            filterBtns.forEach((b) => {
                const isSelected = b === selectedBtn;
                b.classList.toggle("bg-[#0db7b9]", isSelected);
                b.classList.toggle("text-zinc-950", isSelected);
                b.classList.toggle("font-bold", isSelected);
                b.classList.toggle("text-zinc-400", !isSelected);
                b.classList.toggle("font-medium", !isSelected);
                b.setAttribute("aria-selected", String(isSelected));
                b.setAttribute("tabindex", isSelected ? "0" : "-1");
            });

            const visibleCards: HTMLElement[] = [];

            projectCards.forEach((item) => {
                const category = item.getAttribute("data-category");
                const isVisible = filter === "all" || category === filter;
                item.style.display = isVisible ? "flex" : "none";
                if (isVisible) {
                    visibleCards.push(item);
                }
            });

            rebalanceBentoLayout(visibleCards);
        }

        // Initialize layout for initial 'all' state
        rebalanceBentoLayout(projectCards);

        filterBtns.forEach((btn, index) => {
            btn.addEventListener("click", () => setActiveTab(btn));

            btn.addEventListener("keydown", (e) => {
                let nextIndex = index;
                if (e.key === "ArrowRight" || e.key === "ArrowDown") {
                    e.preventDefault();
                    nextIndex = (index + 1) % filterBtns.length;
                    setActiveTab(filterBtns[nextIndex]);
                    filterBtns[nextIndex].focus();
                } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
                    e.preventDefault();
                    nextIndex =
                        (index - 1 + filterBtns.length) % filterBtns.length;
                    setActiveTab(filterBtns[nextIndex]);
                    filterBtns[nextIndex].focus();
                } else if (e.key === "Home") {
                    e.preventDefault();
                    setActiveTab(filterBtns[0]);
                    filterBtns[0].focus();
                } else if (e.key === "End") {
                    e.preventDefault();
                    setActiveTab(filterBtns[filterBtns.length - 1]);
                    filterBtns[filterBtns.length - 1].focus();
                }
            });
        });
    }

    document.addEventListener("astro:page-load", initProjects);
</script>
