---
import { projects } from '../data/projects';
import { translations } from '../data/translations';
import ProjectCard from './ProjectCard.astro';
import { FolderGit2 } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="projects" class="py-24 border-t border-zinc-800/80 relative" aria-labelledby="projects-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-mono text-sky-400">
          <FolderGit2 class="w-3.5 h-3.5" />
          <span>01 // {lang === 'es' ? 'PORTFOLIO' : 'SHOWCASE'}</span>
        </div>
        <h2 id="projects-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
          {t.projects.sectionTitle}
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base font-sans max-w-xl">
          {t.projects.sectionSubtitle}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-lg bg-zinc-900/90 border border-zinc-800 font-mono text-xs" role="tablist">
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md bg-sky-500 text-zinc-950 font-semibold transition-all cursor-pointer"
          data-filter="all"
          role="tab"
          aria-selected="true"
        >
          {t.projects.filterAll}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer"
          data-filter="astro"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterAstro}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer"
          data-filter="fullstack"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterFullstack}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer"
          data-filter="tools"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterTools}
        </button>
      </div>
    </div>

    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-sky-500', 'text-zinc-950', 'font-semibold');
        b.classList.add('text-zinc-400');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('bg-sky-500', 'text-zinc-950', 'font-semibold');
      btn.classList.remove('text-zinc-400');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
