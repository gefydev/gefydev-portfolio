---
import { projects, openSourceContributions } from '../data/projects';
import { translations } from '../data/translations';
import ProjectCard from './ProjectCard.astro';
import { FolderGit2, GitPullRequest, Star, ExternalLink, Github, Sparkles } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section id="projects" class="py-24 border-t border-zinc-800/80 relative" aria-labelledby="projects-title">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-xs font-sans font-medium text-[#0db7b9]">
          <FolderGit2 class="w-3.5 h-3.5" />
          <span>01 // {lang === 'es' ? 'PORTFOLIO' : 'SHOWCASE'}</span>
        </div>
        <h2 id="projects-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white font-sans">
          {t.projects.sectionTitle}
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base font-sans max-w-xl">
          {t.projects.sectionSubtitle}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-1.5 p-1 rounded-lg bg-zinc-900/90 border border-zinc-800 font-sans text-xs" role="tablist">
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md bg-[#0db7b9] text-zinc-950 font-bold transition-all cursor-pointer"
          data-filter="all"
          role="tab"
          aria-selected="true"
        >
          {t.projects.filterAll}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium"
          data-filter="rust"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterRust}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium"
          data-filter="astro"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterAstro}
        </button>
        <button
          type="button"
          class="project-filter-btn px-3 py-1.5 rounded-md text-zinc-400 hover:text-white hover:bg-zinc-800 transition-all cursor-pointer font-medium"
          data-filter="web"
          role="tab"
          aria-selected="false"
        >
          {t.projects.filterWeb}
        </button>
      </div>
    </div>

    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {projects.map((project) => (
        <ProjectCard project={project} lang={lang} />
      ))}
    </div>

    <div id="contributions" class="pt-8 border-t border-zinc-800/80 space-y-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[#735ed5]/10 border border-[#735ed5]/30 text-xs font-sans font-medium text-purple-300">
          <GitPullRequest class="w-3.5 h-3.5" />
          <span>OPEN SOURCE</span>
        </div>
        <h3 class="text-2xl font-bold text-white font-sans">
          {t.projects.contributionsTitle}
        </h3>
        <p class="text-zinc-400 text-sm font-sans max-w-xl">
          {t.projects.contributionsSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {openSourceContributions.map((item) => (
          <div class="rounded-2xl bg-gradient-to-r from-zinc-950 via-[#121524] to-zinc-950 border border-zinc-800 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl">
            <div class="space-y-3 max-w-2xl">
              <div class="flex flex-wrap items-center gap-3">
                <span class="font-sans text-xl font-bold text-white">
                  {item.author} / <span class="text-[#0db7b9]">{item.repo}</span>
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-sans font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                  <Sparkles class="w-3 h-3" />
                  <span>{item.role[lang]}</span>
                </span>
                <span class="flex items-center gap-1 text-xs font-mono text-amber-400">
                  <Star class="w-3.5 h-3.5 fill-amber-400/30" />
                  <span>{item.stars} stars</span>
                </span>
              </div>

              <p class="text-sm text-zinc-300 leading-relaxed font-sans">
                {item.description[lang]}
              </p>

              <div class="flex flex-wrap gap-2 pt-1">
                {item.techTags.map((tag) => (
                  <span 
                    class="px-2.5 py-0.5 rounded text-xs font-sans font-medium border"
                    style={`color: ${tag.color}; background-color: ${tag.bg}; border-color: ${tag.border};`}
                  >
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>

            <div class="shrink-0 flex items-center gap-3">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-white font-sans text-xs font-semibold transition-colors"
                aria-label={`Ver repositorio ${item.repo} en GitHub`}
              >
                <Github class="w-4 h-4" />
                <span>{lang === 'es' ? 'Ver en GitHub' : 'View on GitHub'}</span>
                <ExternalLink class="w-3.5 h-3.5 text-zinc-400" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.project-filter-btn');
  const projectItems = document.querySelectorAll('.project-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-[#0db7b9]', 'text-zinc-950', 'font-bold');
        b.classList.add('text-zinc-400', 'font-medium');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.add('bg-[#0db7b9]', 'text-zinc-950', 'font-bold');
      btn.classList.remove('text-zinc-400', 'font-medium');
      btn.setAttribute('aria-selected', 'true');

      const filter = btn.getAttribute('data-filter');

      projectItems.forEach((item) => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = 'flex';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
