---
import { projects, openSourceContributions } from '../data/projects';
import { translations } from '../data/translations';
import ProjectCard from './ProjectCard.astro';
import { FolderGit2, GitPullRequest, Star, ExternalLink, Github, Sparkles } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];

// Default asymmetric layout spans for all 5 projects
const defaultSpans = [
  'col-span-12 md:col-span-7', // 0: Spotifust
  'col-span-12 md:col-span-5', // 1: ComiDólar
  'col-span-12 md:col-span-5', // 2: GenaCleaner
  'col-span-12 md:col-span-7', // 3: 412 Stream
  'col-span-12 md:col-span-12', // 4: BlackMaps
];
---

<section id="projects" class="py-24 border-t border-zinc-800/80 relative font-sans section-cv" aria-labelledby="projects-title">
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-[#0db7b9]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900/90 border border-zinc-800 text-xs font-mono text-[#0db7b9]">
          <FolderGit2 class="w-3.5 h-3.5" />
          <span class="font-bold">01. // {lang === 'es' ? 'PROYECTOS & SHOWCASE' : 'PROJECTS & SHOWCASE'}</span>
        </div>
        <h2 id="projects-title" class="text-3xl sm:text-4xl font-bold tracking-tight text-white">
          {t.projects.sectionTitle}
        </h2>
        <p class="text-zinc-400 text-sm sm:text-base max-w-xl">
          {t.projects.sectionSubtitle}
        </p>
      </div>

      <!-- Filter Tabs -->
      <div
        class="flex flex-wrap items-center gap-1.5 p-1.5 rounded-xl bg-zinc-900/90 border border-zinc-800 text-xs"
        role="tablist"
        aria-label={lang === 'es' ? 'Filtros de proyectos' : 'Project category filters'}
      >
        <button
          type="button"
          class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg bg-[#0db7b9] text-zinc-950 font-bold transition-all cursor-pointer active:scale-[0.98]"
          data-filter="all"
          role="tab"
          aria-selected="true"
          tabindex="0"
        >
          {t.projects.filterAll}
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 font-medium hover:text-white transition-all cursor-pointer active:scale-[0.98]"
          data-filter="rust"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterRust}
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 font-medium hover:text-white transition-all cursor-pointer active:scale-[0.98]"
          data-filter="astro"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterAstro}
        </button>
        <button
          type="button"
          class="project-filter-btn px-4 py-2 min-h-[40px] rounded-lg text-zinc-400 font-medium hover:text-white transition-all cursor-pointer active:scale-[0.98]"
          data-filter="web"
          role="tab"
          aria-selected="false"
          tabindex="-1"
        >
          {t.projects.filterWeb}
        </button>
      </div>
    </div>

    <!-- Dynamic Asymmetric Bento Grid for 5 Projects -->
    <div id="projects-bento-grid" class="grid grid-cols-1 md:grid-cols-12 gap-6 items-stretch">
      {projects.map((project, index) => (
        <ProjectCard
          project={project}
          lang={lang}
          defaultSpan={defaultSpans[index] || 'col-span-12 md:col-span-6'}
        />
      ))}
    </div>

    <!-- ========================================== -->
    <!-- OPEN SOURCE CONTRIBUTIONS SECTION -->
    <!-- ========================================== -->
    <div id="contributions" class="pt-8 border-t border-zinc-800/80 space-y-6">
      <div class="space-y-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#735ed5]/10 border border-[#735ed5]/30 text-xs font-mono font-semibold text-purple-300">
          <GitPullRequest class="w-3.5 h-3.5" />
          <span>OPEN SOURCE CONTRIBUTIONS</span>
        </div>
        <h3 class="text-2xl font-bold text-white">
          {t.projects.contributionsTitle}
        </h3>
        <p class="text-zinc-400 text-sm max-w-xl">
          {t.projects.contributionsSubtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4">
        {openSourceContributions.map((item) => (
          <div class="group relative overflow-hidden rounded-2xl bg-gradient-to-r from-zinc-950 via-[#0d101a] to-zinc-950 border border-zinc-800/90 hover:border-purple-500/40 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl transition-all duration-300">

            <!-- Stremio SVG Watermark fading in from left -->
            {item.repo.toLowerCase().includes('stremio') && (
              <div
                class="pointer-events-none absolute -left-12 -top-10 -bottom-10 w-80 flex items-center justify-start opacity-20 group-hover:opacity-35 transition-all duration-700 ease-out transform -translate-x-4 group-hover:translate-x-0 overflow-hidden"
                style="mask-image: linear-gradient(to right, rgba(0,0,0,0.9) 15%, rgba(0,0,0,0) 85%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0.9) 15%, rgba(0,0,0,0) 85%);"
                aria-hidden="true"
              >
                <svg class="w-72 h-72 shrink-0 -rotate-6 filter drop-shadow-[0_0_25px_rgba(123,91,245,0.3)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 124.926 124.927">
                  <defs>
                    <linearGradient id="stremio-watermark-grad" x1="1" x2=".296" y1="1" y2=".296" gradientUnits="objectBoundingBox">
                      <stop offset="0" stop-color="#1155d9"/>
                      <stop offset="1" stop-color="#7b5bf5"/>
                    </linearGradient>
                  </defs>
                  <g data-name="Group 2115" transform="translate(.001)">
                    <rect width="88.336" height="88.336" fill="url(#stremio-watermark-grad)" rx="6" transform="rotate(45 31.231 75.4)"/>
                    <path fill="#fff" d="M83.389 61.658a1 1 0 0 1 0 1.611L54.75 84.334a1 1 0 0 1-1.592-.806V41.399a1 1 0 0 1 1.592-.806Z" data-name="Polygon 20"/>
                  </g>
                </svg>
              </div>
            )}

            <div class="relative z-10 space-y-3 max-w-2xl">
              <div class="flex flex-wrap items-center gap-3">
                {item.repo.toLowerCase().includes('stremio') && (
                  <div class="w-8 h-8 shrink-0 rounded-lg bg-gradient-to-br from-blue-900/60 to-purple-900/60 border border-purple-500/30 p-1 flex items-center justify-center shadow-md shadow-purple-500/20 group-hover:scale-105 transition-transform">
                    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 124.926 124.927">
                      <defs>
                        <linearGradient id="stremio-icon-grad" x1="1" x2=".296" y1="1" y2=".296" gradientUnits="objectBoundingBox">
                          <stop offset="0" stop-color="#1155d9"/>
                          <stop offset="1" stop-color="#7b5bf5"/>
                        </linearGradient>
                      </defs>
                      <g transform="translate(.001)">
                        <rect width="88.336" height="88.336" fill="url(#stremio-icon-grad)" rx="6" transform="rotate(45 31.231 75.4)"/>
                        <path fill="#fff" d="M83.389 61.658a1 1 0 0 1 0 1.611L54.75 84.334a1 1 0 0 1-1.592-.806V41.399a1 1 0 0 1 1.592-.806Z"/>
                      </g>
                    </svg>
                  </div>
                )}
                <span class="text-xl font-bold text-white font-mono">
                  {item.author} / <span class="text-[#0db7b9]">{item.repo}</span>
                </span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                  <Sparkles class="w-3 h-3" />
                  <span>{item.role[lang]}</span>
                </span>
                {item.prsCount && (
                  <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-500/10 border border-purple-500/30 text-purple-300 font-mono">
                    <GitPullRequest class="w-3.5 h-3.5 text-purple-400" />
                    <span>{item.prsCount} {lang === 'es' ? 'PRs fusionadas' : 'PRs merged'}</span>
                  </span>
                )}
                <span class="flex items-center gap-1 text-xs font-mono text-amber-400">
                  <Star class="w-3.5 h-3.5 fill-amber-400/30" />
                  <span>{item.stars} stars</span>
                </span>
              </div>

              <p class="text-sm text-zinc-300 leading-relaxed font-sans">
                {item.description[lang]}
              </p>

              <div class="flex flex-wrap gap-2 pt-1 font-mono text-xs">
                {item.techTags.map((tag) => (
                  <span
                    class="px-2.5 py-0.5 rounded-md border"
                    style={`color: ${tag.color}; background-color: ${tag.bg}; border-color: ${tag.border};`}
                  >
                    {tag.name}
                  </span>
                ))}
              </div>
            </div>

            <div class="relative z-10 shrink-0 flex items-center gap-3">
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-3 min-h-[44px] rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-700 text-white text-xs font-semibold transition-colors active:scale-[0.98]"
                aria-label={lang === 'es' ? `Ver repositorio ${item.repo} en GitHub` : `View ${item.repo} repository on GitHub`}
              >
                <Github class="w-4 h-4" />
                <span>{lang === 'es' ? 'Ver en GitHub' : 'View on GitHub'}</span>
                <ExternalLink class="w-3.5 h-3.5 text-zinc-400" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initProjects() {
    const filterContainer = document.querySelector('[role="tablist"]');
    if (!filterContainer || (filterContainer as HTMLElement).dataset.bound) return;
    (filterContainer as HTMLElement).dataset.bound = 'true';

    const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.project-filter-btn'));
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>('.bento-project-card'));
    const grid = document.getElementById('projects-bento-grid');

    // Highly optimized spotlight: calculates rect ONLY on the single hovered card without layout thrashing
    let rafId: number | null = null;
    function handleMouseMove(e: MouseEvent) {
      if (rafId) cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(() => {
        const targetCard = (e.target as HTMLElement)?.closest<HTMLElement>('.bento-project-card');
        if (targetCard && targetCard.style.display !== 'none') {
          const rect = targetCard.getBoundingClientRect();
          targetCard.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
          targetCard.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
        }
      });
    }

    grid?.addEventListener('mousemove', handleMouseMove, { passive: true });

    // Dynamic Asymmetric Bento layout distributor
    function rebalanceBentoLayout(visibleCards: HTMLElement[]) {
      const count = visibleCards.length;

      visibleCards.forEach((card, index) => {
        // Remove old span classes
        card.classList.remove('md:col-span-5', 'md:col-span-6', 'md:col-span-7', 'md:col-span-12');

        if (count === 1) {
          card.classList.add('md:col-span-12');
        } else if (count === 2) {
          card.classList.add(index === 0 ? 'md:col-span-7' : 'md:col-span-5');
        } else if (count === 3) {
          if (index === 0) card.classList.add('md:col-span-7');
          else if (index === 1) card.classList.add('md:col-span-5');
          else card.classList.add('md:col-span-12');
        } else if (count === 4) {
          if (index === 0) card.classList.add('md:col-span-7');
          else if (index === 1) card.classList.add('md:col-span-5');
          else if (index === 2) card.classList.add('md:col-span-5');
          else card.classList.add('md:col-span-7');
        } else if (count === 5) {
          if (index === 0) card.classList.add('md:col-span-7');
          else if (index === 1) card.classList.add('md:col-span-5');
          else if (index === 2) card.classList.add('md:col-span-5');
          else if (index === 3) card.classList.add('md:col-span-7');
          else card.classList.add('md:col-span-12');
        } else {
          card.classList.add('md:col-span-6');
        }
      });
    }

    function setActiveTab(activeBtn: HTMLButtonElement) {
      const filter = activeBtn.getAttribute('data-filter') || 'all';

      filterBtns.forEach((b) => {
        const isSelected = b === activeBtn;
        b.classList.toggle('bg-[#0db7b9]', isSelected);
        b.classList.toggle('text-zinc-950', isSelected);
        b.classList.toggle('font-bold', isSelected);
        b.classList.toggle('text-zinc-400', !isSelected);
        b.classList.toggle('font-medium', !isSelected);
        b.setAttribute('aria-selected', String(isSelected));
        b.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      const visibleCards: HTMLElement[] = [];

      projectCards.forEach((item) => {
        const category = item.getAttribute('data-category');
        const isVisible = filter === 'all' || category === filter;
        item.style.display = isVisible ? 'flex' : 'none';
        if (isVisible) {
          visibleCards.push(item);
        }
      });

      rebalanceBentoLayout(visibleCards);
    }

    // Initialize layout for initial 'all' state
    rebalanceBentoLayout(projectCards);

    filterBtns.forEach((btn, index) => {
      btn.addEventListener('click', () => setActiveTab(btn));

      btn.addEventListener('keydown', (e) => {
        let nextIndex = index;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          e.preventDefault();
          nextIndex = (index + 1) % filterBtns.length;
          setActiveTab(filterBtns[nextIndex]);
          filterBtns[nextIndex].focus();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          e.preventDefault();
          nextIndex = (index - 1 + filterBtns.length) % filterBtns.length;
          setActiveTab(filterBtns[nextIndex]);
          filterBtns[nextIndex].focus();
        } else if (e.key === 'Home') {
          e.preventDefault();
          setActiveTab(filterBtns[0]);
          filterBtns[0].focus();
        } else if (e.key === 'End') {
          e.preventDefault();
          setActiveTab(filterBtns[filterBtns.length - 1]);
          filterBtns[filterBtns.length - 1].focus();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjects);
  } else {
    initProjects();
  }
  document.addEventListener('astro:page-load', initProjects);
</script>
