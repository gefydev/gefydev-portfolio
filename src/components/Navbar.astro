---
import { translations } from '../data/translations';
import { Terminal, Globe, Menu, X, ArrowUpRight } from 'lucide-astro';

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;
const t = translations[lang];
const otherLang = lang === 'es' ? 'en' : 'es';
const otherLangUrl = `/${otherLang}`;
---

<header class="fixed top-0 inset-x-0 z-40 transition-all duration-300 border-b border-white/[0.06] bg-[#07080c]/80 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a 
        href={`/${lang}`} 
        class="group flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight text-white hover:text-sky-400 transition-colors focus-visible:ring-1 focus-visible:ring-sky-400 rounded-sm"
        aria-label="GenaDeev Home"
      >
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-sky-500/10 border border-sky-500/30 text-sky-400 font-bold group-hover:scale-105 transition-transform">
          GD
        </span>
        <span class="flex items-center">
          <span class="text-zinc-400 group-hover:text-zinc-200 transition-colors">gena</span>
          <span class="text-sky-400">.dev</span>
        </span>
      </a>

      <div class="hidden md:flex items-center gap-2 pl-3 border-l border-zinc-800 text-xs font-mono text-zinc-400">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-zinc-400">BA (GMT-3)</span>
        <span id="nav-live-clock" class="text-zinc-200 tabular-nums">--:--:--</span>
      </div>
    </div>

    <nav class="hidden md:flex items-center gap-6 text-xs font-mono uppercase tracking-wider text-zinc-400" aria-label="Main Navigation">
      <a href="#projects" class="hover:text-white transition-colors py-1 focus-visible:text-sky-400">{t.nav.projects}</a>
      <a href="#stack" class="hover:text-white transition-colors py-1 focus-visible:text-sky-400">{t.nav.stack}</a>
      <a href="#about" class="hover:text-white transition-colors py-1 focus-visible:text-sky-400">{t.nav.about}</a>
      <a href="#contact" class="hover:text-white transition-colors py-1 focus-visible:text-sky-400">{t.nav.contact}</a>
    </nav>

    <div class="flex items-center gap-2.5">
      <button
        id="cmd-palette-btn"
        type="button"
        class="hidden sm:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-md bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-zinc-200 text-xs font-mono transition-all cursor-pointer shadow-xs"
        aria-label="Abrir paleta de comandos (Cmd+K / Ctrl+K)"
      >
        <Terminal class="w-3.5 h-3.5 text-sky-400" />
        <span class="text-[11px] text-zinc-400">{t.nav.commandPalette}</span>
        <kbd class="px-1.5 py-0.5 text-[10px] bg-zinc-800 border border-zinc-700/80 rounded text-zinc-400 font-mono">⌘K</kbd>
      </button>

      <a
        href={otherLangUrl}
        id="lang-toggle-btn"
        data-target-lang={otherLang}
        class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md bg-zinc-900/80 hover:bg-zinc-800 border border-zinc-800 hover:border-sky-500/40 text-xs font-mono text-zinc-300 hover:text-sky-400 transition-all cursor-pointer"
        aria-label={`Cambiar idioma a ${otherLang.toUpperCase()}`}
      >
        <Globe class="w-3.5 h-3.5 text-zinc-400" />
        <span class="font-bold">{lang.toUpperCase()}</span>
        <span class="text-zinc-500 text-[10px]">/ {otherLang.toUpperCase()}</span>
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-md bg-zinc-900 border border-zinc-800 text-zinc-300 hover:text-white transition-colors"
        aria-label="Alternar menú de navegación"
        aria-expanded="false"
      >
        <Menu class="w-5 h-5 menu-open-icon" />
        <X class="w-5 h-5 menu-close-icon hidden" />
      </button>
    </div>
  </div>

  <div id="mobile-menu-drawer" class="hidden md:hidden border-b border-zinc-800/80 bg-[#07080c]/95 backdrop-blur-xl px-6 py-5 space-y-4 font-mono text-sm">
    <div class="flex flex-col space-y-3">
      <a href="#projects" class="mobile-nav-link text-zinc-300 hover:text-sky-400 py-1.5 flex items-center justify-between border-b border-zinc-900">
        <span>{t.nav.projects}</span>
        <ArrowUpRight class="w-4 h-4 text-zinc-600" />
      </a>
      <a href="#stack" class="mobile-nav-link text-zinc-300 hover:text-sky-400 py-1.5 flex items-center justify-between border-b border-zinc-900">
        <span>{t.nav.stack}</span>
        <ArrowUpRight class="w-4 h-4 text-zinc-600" />
      </a>
      <a href="#about" class="mobile-nav-link text-zinc-300 hover:text-sky-400 py-1.5 flex items-center justify-between border-b border-zinc-900">
        <span>{t.nav.about}</span>
        <ArrowUpRight class="w-4 h-4 text-zinc-600" />
      </a>
      <a href="#contact" class="mobile-nav-link text-zinc-300 hover:text-sky-400 py-1.5 flex items-center justify-between">
        <span>{t.nav.contact}</span>
        <ArrowUpRight class="w-4 h-4 text-zinc-600" />
      </a>
    </div>

    <div class="pt-2 border-t border-zinc-800 flex items-center justify-between text-xs text-zinc-400">
      <div class="flex items-center gap-2">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span>BA Time: <span id="mobile-live-clock" class="text-zinc-200">--:--:--</span></span>
      </div>
      <button id="mobile-cmd-btn" class="px-2.5 py-1 rounded bg-zinc-800 text-zinc-300 flex items-center gap-1.5">
        <Terminal class="w-3 h-3 text-sky-400" />
        <span>⌘K</span>
      </button>
    </div>
  </div>
</header>

<script>
  function updateBuenosAiresClock() {
    const clockEls = [document.getElementById('nav-live-clock'), document.getElementById('mobile-live-clock')];
    if (!clockEls[0] && !clockEls[1]) return;

    try {
      const now = new Date();
      const formatter = new Intl.DateTimeFormat('es-AR', {
        timeZone: 'America/Argentina/Buenos_Aires',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false,
      });
      const timeStr = formatter.format(now);
      clockEls.forEach((el) => {
        if (el) el.textContent = timeStr;
      });
    } catch {
      const fallback = new Date().toLocaleTimeString();
      clockEls.forEach((el) => {
        if (el) el.textContent = fallback;
      });
    }
  }

  updateBuenosAiresClock();
  setInterval(updateBuenosAiresClock, 1000);

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const drawer = document.getElementById('mobile-menu-drawer');
  const openIcon = mobileBtn?.querySelector('.menu-open-icon');
  const closeIcon = mobileBtn?.querySelector('.menu-close-icon');

  function toggleMobileMenu() {
    if (!drawer || !mobileBtn) return;
    const isExpanded = drawer.classList.toggle('hidden');
    mobileBtn.setAttribute('aria-expanded', String(!isExpanded));
    openIcon?.classList.toggle('hidden', !isExpanded);
    closeIcon?.classList.toggle('hidden', isExpanded);
  }

  mobileBtn?.addEventListener('click', toggleMobileMenu);

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      if (drawer && !drawer.classList.contains('hidden')) {
        toggleMobileMenu();
      }
    });
  });

  const langToggle = document.getElementById('lang-toggle-btn');
  langToggle?.addEventListener('click', (e) => {
    const targetLang = langToggle.getAttribute('data-target-lang');
    if (targetLang) {
      document.cookie = `user_lang=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
    }
  });

  const mobileCmdBtn = document.getElementById('mobile-cmd-btn');
  mobileCmdBtn?.addEventListener('click', () => {
    if (drawer && !drawer.classList.contains('hidden')) {
      toggleMobileMenu();
    }
    window.dispatchEvent(new CustomEvent('toggle-terminal'));
  });
</script>
