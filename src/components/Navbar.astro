---
import { translations } from "../data/translations";
import { cvLink } from "../data/cv";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
const otherLang = lang === "es" ? "en" : "es";
const otherLangUrl = `/${otherLang}`;

const cmdAriaLabel =
    lang === "es"
        ? "Abrir paleta de comandos (Cmd+K / Ctrl+K)"
        : "Open command palette (Cmd+K / Ctrl+K)";
const langAriaLabel =
    lang === "es" ? "Cambiar idioma a Inglés" : "Switch language to Spanish";
const menuAriaLabel =
    lang === "es"
        ? "Alternar menú de navegación móvil"
        : "Toggle mobile navigation menu";

const githubUrl = "https://github.com/gefydev";
const cv = cvLink(lang);

const links = [
    { href: "#projects", label: t.nav.projects },
    { href: "#contributions", label: t.nav.contributions },
    { href: "#stack", label: t.nav.stack },
    { href: "#about", label: t.nav.about },
    { href: "#contact", label: t.nav.contact },
];
---

<header class="site-header">
    <div class="wrap bar">
        <a href={`/${lang}`} class="brand" aria-label="GefyDev Home">
            <img
                src="/images/logo-white-bg.webp"
                alt=""
                width="20"
                height="20"
            />
            <span>gefy.dev</span>
        </a>

        <nav class="nav" aria-label="Main Navigation">
            {links.map((l) => <a href={l.href}>{l.label}</a>)}
            <a href={githubUrl} target="_blank" rel="noopener noreferrer me">GitHub</a>
            <a href={cv.href} download={cv.file} aria-label={cv.label} data-astro-reload>CV</a>
        </nav>

        <div class="tools">
            <button
                id="cmd-palette-btn"
                type="button"
                class="kbd-btn"
                aria-label={cmdAriaLabel}
            >
                ⌘K
            </button>

            <a
                href={otherLangUrl}
                id="lang-toggle-btn"
                data-target-lang={otherLang}
                class="lang"
                aria-label={langAriaLabel}
            >
                <span aria-current={lang === "es" ? "true" : undefined}>ES</span
                ><span aria-hidden="true">/</span><span
                    aria-current={lang === "en" ? "true" : undefined}>EN</span
                >
            </a>

            <button
                id="mobile-menu-btn"
                type="button"
                class="menu-btn md:hidden"
                aria-label={menuAriaLabel}
                aria-expanded="false"
                aria-controls="mobile-menu-drawer"
            >
                <span class="menu-open-icon">{lang === "es" ? "Menú" : "Menu"}</span>
                <span class="menu-close-icon hidden">{lang === "es" ? "Cerrar" : "Close"}</span>
            </button>
        </div>
    </div>

    <nav
        id="mobile-menu-drawer"
        class="menu-list md:hidden"
        aria-label={lang === "es" ? "Navegación móvil" : "Mobile Navigation"}
    >
        <div class="menu-sheet">
            {
                links.map((l) => (
                    <a href={l.href} class="mobile-nav-link">
                        <span>{l.label}</span>
                        <span class="hint" aria-hidden="true">↗</span>
                    </a>
                ))
            }
            <a href={githubUrl} target="_blank" rel="noopener noreferrer me" class="mobile-nav-link">
                <span>GitHub</span>
                <span class="hint" aria-hidden="true">↗</span>
            </a>
            <a href={cv.href} download={cv.file} aria-label={cv.label} class="mobile-nav-link" data-astro-reload>
                <span>CV (PDF)</span>
                <span class="hint" aria-hidden="true">↓</span>
            </a>
            <button id="mobile-cmd-btn" type="button">
                <span>{t.nav.commandPalette}</span>
                <span class="hint" aria-hidden="true">⌘K</span>
            </button>
        </div>
    </nav>
</header>

<script>
    let clockInterval: ReturnType<typeof setInterval> | null = null;
    const timeFormatter = new Intl.DateTimeFormat("es-AR", {
        timeZone: "America/Argentina/Buenos_Aires",
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
        hour12: false,
    });

    function updateAllClocks() {
        try {
            if (document.hidden) return;
            const now = new Date();
            const timeStr = timeFormatter.format(now);
            const targets = document.querySelectorAll(
                "#nav-live-clock, #mobile-live-clock, #about-live-clock",
            );
            targets.forEach((el) => {
                if (el) el.textContent = timeStr;
            });
        } catch {}
    }

    function initNavbar() {
        if (clockInterval) clearInterval(clockInterval);
        updateAllClocks();
        clockInterval = setInterval(updateAllClocks, 1000);
    }

    // El cajón nace del botón «Menú»: se mide el centro del botón respecto del cajón y CSS lo usa de origen.
    function setDrawerOrigin(drawer: HTMLElement, btn: HTMLElement) {
        const d = drawer.getBoundingClientRect();
        const b = btn.getBoundingClientRect();
        drawer.style.setProperty("--ox", `${(b.left + b.width / 2 - d.left).toFixed(1)}px`);
        drawer.style.setProperty("--oy", `${(b.top + b.height / 2 - d.top).toFixed(1)}px`);
    }

    function closeMobileDrawer(returnFocus = false) {
        const drawer = document.getElementById("mobile-menu-drawer");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        if (!drawer || !mobileBtn) return;
        mobileBtn.classList.add("has-toggled");
        drawer.classList.remove("is-open");
        mobileBtn.setAttribute("aria-expanded", "false");
        if (returnFocus) mobileBtn.focus({ preventScroll: true });
        mobileBtn.querySelector(".menu-open-icon")?.classList.remove("hidden");
        mobileBtn.querySelector(".menu-close-icon")?.classList.add("hidden");
    }

    function toggleMobileDrawer() {
        const drawer = document.getElementById("mobile-menu-drawer");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        if (!drawer || !mobileBtn) return;
        mobileBtn.classList.add("has-toggled");
        if (!drawer.classList.contains("is-open")) setDrawerOrigin(drawer, mobileBtn);
        const isHidden = !drawer.classList.toggle("is-open");
        mobileBtn.setAttribute("aria-expanded", String(!isHidden));
        mobileBtn
            .querySelector(".menu-open-icon")
            ?.classList.toggle("hidden", !isHidden);
        mobileBtn
            .querySelector(".menu-close-icon")
            ?.classList.toggle("hidden", isHidden);
    }

    // Delegated document click listeners
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        // Command palette button click (desktop or mobile)
        if (target.closest("#cmd-palette-btn")) {
            window.dispatchEvent(new CustomEvent("toggle-terminal"));
            return;
        }

        if (target.closest("#mobile-cmd-btn")) {
            closeMobileDrawer();
            window.dispatchEvent(new CustomEvent("toggle-terminal"));
            return;
        }

        // Mobile menu toggle button
        if (target.closest("#mobile-menu-btn")) {
            toggleMobileDrawer();
            return;
        }

        // Mobile nav links
        if (target.closest(".mobile-nav-link")) {
            closeMobileDrawer();
            return;
        }

        // Language toggle button cookie persistence
        const langBtn = target.closest<HTMLElement>("#lang-toggle-btn");
        if (langBtn) {
            const targetLang = langBtn.getAttribute("data-target-lang");
            if (targetLang) {
                document.cookie = `user_lang=${targetLang}; path=/; max-age=31536000; SameSite=Lax`;
            }
            return;
        }

        // Outside click to close mobile menu
        const drawer = document.getElementById("mobile-menu-drawer");
        const mobileBtn = document.getElementById("mobile-menu-btn");
        if (drawer && drawer.classList.contains("is-open")) {
            if (!drawer.contains(target) && !mobileBtn?.contains(target)) {
                // el foco vuelve al botón, salvo que el clic cayó en algo enfocable (no se lo robamos)
                closeMobileDrawer(!target.closest("a, button, input, textarea, select, summary, [tabindex]"));
            }
        }
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            const drawer = document.getElementById("mobile-menu-drawer");
            if (drawer && drawer.classList.contains("is-open")) {
                closeMobileDrawer(true);
            }
        }
    });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initNavbar);
    } else {
        initNavbar();
    }
    document.addEventListener("astro:page-load", initNavbar);
    document.addEventListener("astro:before-swap", () => {
        if (clockInterval) {
            clearInterval(clockInterval);
            clockInterval = null;
        }
    });
</script>
