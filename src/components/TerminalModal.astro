---
import { translations } from "../data/translations";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
const otherLang = lang === "es" ? "en" : "es";
const closeAria =
    lang === "es" ? "Cerrar paleta de comandos" : "Close command palette";
---

<div
    id="terminal-modal"
    class="overlay hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cmd-palette-title"
>
    <div id="terminal-card" class="palette">
        <span id="cmd-palette-title" class="sr-only">{t.terminal.title}</span>
        <div class="palette-top">
            <input
                id="terminal-search-input"
                type="text"
                placeholder={t.terminal.searchPlaceholder}
                autocomplete="off"
                spellcheck="false"
            />
            <button
                id="close-terminal-btn"
                type="button"
                class="kbd"
                style="background: none; cursor: pointer"
                aria-label={closeAria}
            >
                ESC
            </button>
        </div>

        <div id="terminal-list" class="palette-list">
            <div class="palette-group">{t.terminal.navigation}</div>

            <button type="button" class="terminal-item palette-item" data-action="navigate" data-target="#projects">
                <span>{t.terminal.goToProjects}</span>
                <kbd class="kbd">#projects</kbd>
            </button>
            <button type="button" class="terminal-item palette-item" data-action="navigate" data-target="#contributions">
                <span>{t.terminal.goToContributions}</span>
                <kbd class="kbd">#contributions</kbd>
            </button>
            <button type="button" class="terminal-item palette-item" data-action="navigate" data-target="#stack">
                <span>{t.terminal.goToStack}</span>
                <kbd class="kbd">#stack</kbd>
            </button>
            <button type="button" class="terminal-item palette-item" data-action="navigate" data-target="#about">
                <span>{t.terminal.goToAbout}</span>
                <kbd class="kbd">#about</kbd>
            </button>
            <button type="button" class="terminal-item palette-item" data-action="navigate" data-target="#contact">
                <span>{t.terminal.goToContact}</span>
                <kbd class="kbd">#contact</kbd>
            </button>

            <div class="palette-group">{t.terminal.actions}</div>

            <!--email_off-->
            <button type="button" class="terminal-item palette-item" data-action="copy-email">
                <span class="copy-email-text">{t.terminal.copyEmail}</span>
                <kbd class="kbd">hi@gefy.dev</kbd>
            </button>
            <!--/email_off-->

            <button
                type="button"
                class="terminal-item palette-item"
                data-action="switch-lang"
                data-target-lang={otherLang}
            >
                <span>{t.terminal.switchLanguage}</span>
                <kbd class="kbd">{otherLang.toUpperCase()}</kbd>
            </button>

            <button
                type="button"
                class="terminal-item palette-item"
                data-action="open-url"
                data-url="https://github.com/gefydev"
            >
                <span>{t.terminal.openGithub}</span>
                <span aria-hidden="true" class="kbd" style="border: 0">↗</span>
            </button>

            <button
                type="button"
                class="terminal-item palette-item"
                data-action="open-url"
                data-url="https://linkedin.com/in/gefydev"
            >
                <span>{t.terminal.openLinkedin}</span>
                <span aria-hidden="true" class="kbd" style="border: 0">↗</span>
            </button>

            <button
                type="button"
                class="terminal-item palette-item"
                data-action="confetti"
            >
                <span>{t.terminal.triggerConfetti}</span>
            </button>
        </div>

        <div class="palette-foot">
            <span>{t.terminal.close}</span>
            <span class="kbd" style="border: 0">[↵] {lang === "es" ? "Ejecutar" : "Select"}</span>
        </div>
    </div>
</div>

<div id="email-copied-toast" class="toast hidden" role="status">
    {t.terminal.emailCopiedNotice}
</div>

<script>
    let selectedIndex = 0;

    function getTerminalElements() {
        const modal = document.getElementById("terminal-modal");
        const card = document.getElementById("terminal-card");
        const input = document.getElementById(
            "terminal-search-input",
        ) as HTMLInputElement | null;
        const closeBtn = document.getElementById("close-terminal-btn");
        const list = document.getElementById("terminal-list");
        const items = list
            ? (Array.from(
                  list.querySelectorAll(".terminal-item"),
              ) as HTMLButtonElement[])
            : [];
        const toast = document.getElementById("email-copied-toast");

        return { modal, card, input, closeBtn, list, items, toast };
    }

    function openTerminal() {
        const { modal, card, input, items } = getTerminalElements();
        if (!modal || !card || !input) return;

        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        input.value = "";
        selectedIndex = 0;
        filterItems("");
        updateSelection(0);

        requestAnimationFrame(() => {
            input.focus();
        });
    }

    function closeTerminal() {
        const { modal, input } = getTerminalElements();
        if (!modal) return;

        modal.classList.add("hidden");
        document.body.style.overflow = "";
        if (input) input.value = "";
    }

    function toggleTerminal() {
        const { modal } = getTerminalElements();
        if (!modal) return;
        if (modal.classList.contains("hidden")) {
            openTerminal();
        } else {
            closeTerminal();
        }
    }

    function updateSelection(newIndex: number) {
        const { items } = getTerminalElements();
        const visibleItems = items.filter((i) => i.style.display !== "none");
        if (visibleItems.length === 0) return;

        selectedIndex = (newIndex + visibleItems.length) % visibleItems.length;

        visibleItems.forEach((item, idx) => {
            if (idx === selectedIndex) {
                item.classList.add("is-active");
                item.scrollIntoView({ block: "nearest" });
            } else {
                item.classList.remove("is-active");
            }
        });
    }

    function filterItems(query: string) {
        const { items } = getTerminalElements();
        const q = query.toLowerCase().trim();

        items.forEach((item) => {
            const text = item.textContent?.toLowerCase() || "";
            const matches = text.includes(q);
            item.style.display = matches ? "flex" : "none";
        });

        const headers = document.querySelectorAll(
            "#terminal-list > div:not(.terminal-item)",
        );
        headers.forEach((h) => {
            (h as HTMLElement).style.display = q === "" ? "block" : "none";
        });

        selectedIndex = 0;
        updateSelection(0);
    }

    function showToast() {
        const { toast } = getTerminalElements();
        if (!toast) return;
        toast.classList.remove("hidden");
        setTimeout(() => {
            toast.classList.add("hidden");
        }, 3000);
    }

    function triggerModalConfetti(opts: Record<string, any>) {
        const fire = (confettiFn: Function) => {
            confettiFn(opts);
        };

        if ((window as any).confetti) {
            fire((window as any).confetti);
            return;
        }

        const script = document.createElement("script");
        script.src = "/scripts/confetti.min.js";
        script.async = true;
        script.onload = () => {
            if ((window as any).confetti) {
                fire((window as any).confetti);
            }
        };
        document.body.appendChild(script);
    }

    function initTerminal() {
        const { modal, card, input, closeBtn, items } = getTerminalElements();
        if (!modal || (modal as HTMLElement).dataset.bound) return;
        (modal as HTMLElement).dataset.bound = "true";

        closeBtn?.addEventListener("click", closeTerminal);

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeTerminal();
            }
        });

        input?.addEventListener("input", (e) => {
            filterItems((e.target as HTMLInputElement).value);
        });

        items.forEach((item) => {
            item.addEventListener("mouseenter", () => {
                const visibleItems = items.filter(
                    (i) => i.style.display !== "none",
                );
                const idx = visibleItems.indexOf(item);
                if (idx !== -1) updateSelection(idx);
            });

            item.addEventListener("click", () => {
                const action = item.getAttribute("data-action");

                if (action === "navigate") {
                    const target = item.getAttribute("data-target");
                    if (target) {
                        closeTerminal();
                        const el = document.querySelector(target);
                        if (el) {
                            const prefersReducedMotion = window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            ).matches;
                            el.scrollIntoView({
                                behavior: prefersReducedMotion
                                    ? "auto"
                                    : "smooth",
                            });
                        }
                    }
                } else if (action === "copy-email") {
                    if (navigator.clipboard) {
                        navigator.clipboard
                            .writeText("hi@gefy.dev")
                            .then(() => {
                                showToast();
                            })
                            .catch(() => {});
                    }
                    closeTerminal();
                } else if (action === "switch-lang") {
                    const targetLang = item.getAttribute("data-target-lang");
                    if (targetLang) {
                        closeTerminal();
                        window.location.href = `/${targetLang}`;
                    }
                } else if (action === "open-url") {
                    const url = item.getAttribute("data-url");
                    if (url) {
                        window.open(url, "_blank", "noopener,noreferrer");
                        closeTerminal();
                    }
                } else if (action === "confetti") {
                    closeTerminal();
                    triggerModalConfetti({
                        particleCount: 80,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: ["#0db7b9", "#735ed5", "#22d3ee", "#8b5cf6"],
                    });
                }
            });
        });
    }

    // Global Event Listeners for Terminal Modal
    window.addEventListener("open-terminal", openTerminal);
    window.addEventListener("toggle-terminal", toggleTerminal);
    window.addEventListener("close-terminal", closeTerminal);

    document.addEventListener("keydown", (e) => {
        const { modal, input, closeBtn } = getTerminalElements();
        const isHidden = modal?.classList.contains("hidden");

        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            toggleTerminal();
        } else if (e.key === "Escape" && !isHidden) {
            e.preventDefault();
            closeTerminal();
        } else if (!isHidden) {
            const { items, input, closeBtn } = getTerminalElements();
            const visibleItems = items.filter(
                (i) => i.style.display !== "none",
            );

            if (e.key === "ArrowDown") {
                e.preventDefault();
                updateSelection(selectedIndex + 1);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                updateSelection(selectedIndex - 1);
            } else if (e.key === "Enter") {
                e.preventDefault();
                if (visibleItems[selectedIndex]) {
                    visibleItems[selectedIndex].click();
                }
            } else if (e.key === "Tab") {
                e.preventDefault();
                const focusable = [input, closeBtn, ...visibleItems].filter(
                    Boolean,
                ) as HTMLElement[];
                const currentIndex = focusable.indexOf(
                    document.activeElement as HTMLElement,
                );
                const nextIndex = e.shiftKey
                    ? (currentIndex - 1 + focusable.length) % focusable.length
                    : (currentIndex + 1) % focusable.length;
                focusable[nextIndex]?.focus();
            }
        }
    });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTerminal);
    } else {
        initTerminal();
    }
    document.addEventListener("astro:page-load", initTerminal);
</script>
