---
import { translations } from "../data/translations";
import {
    Terminal,
    Search,
    FolderGit2,
    Cpu,
    User,
    Mail,
    Globe,
    Github,
    Linkedin,
    Sparkles,
    X,
    GitPullRequest,
    Check,
} from "lucide-astro";

interface Props {
    lang: "es" | "en";
}

const { lang } = Astro.props;
const t = translations[lang];
const otherLang = lang === "es" ? "en" : "es";
const closeAria =
    lang === "es" ? "Cerrar paleta de comandos" : "Close command palette";
---

<div
    id="terminal-modal"
    class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-start justify-center p-4 sm:p-6 pt-20 sm:pt-28"
    role="dialog"
    aria-modal="true"
    aria-labelledby="cmd-palette-title"
>
    <div
        id="terminal-card"
        class="relative w-full max-w-xl rounded-2xl bg-zinc-950 border border-zinc-800 shadow-2xl overflow-hidden font-sans text-sm"
    >
        <div
            class="flex items-center justify-between px-4 py-3 border-b border-zinc-800 bg-zinc-900/60"
        >
            <div class="flex items-center gap-2 text-zinc-400">
                <Terminal class="w-4 h-4 text-[#0db7b9]" />
                <span
                    id="cmd-palette-title"
                    class="text-xs font-semibold text-zinc-200"
                    >{t.terminal.title}</span
                >
            </div>
            <button
                id="close-terminal-btn"
                type="button"
                class="p-2 min-w-[36px] min-h-[36px] flex items-center justify-center rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors cursor-pointer"
                aria-label={closeAria}
            >
                <X class="w-4 h-4" />
            </button>
        </div>

        <div
            class="relative flex items-center px-4 py-3 border-b border-zinc-800/80"
        >
            <Search class="w-4 h-4 text-zinc-400 mr-3 shrink-0" />
            <input
                id="terminal-search-input"
                type="text"
                placeholder={t.terminal.searchPlaceholder}
                class="w-full bg-transparent text-zinc-100 placeholder:text-zinc-400 focus:outline-hidden text-sm"
                autocomplete="off"
                spellcheck="false"
            />
        </div>

        <div id="terminal-list" class="max-h-80 overflow-y-auto p-2 space-y-1">
            <div
                class="px-3 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-zinc-400"
            >
                {t.terminal.navigation}
            </div>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="navigate"
                data-target="#projects"
            >
                <div class="flex items-center gap-2.5">
                    <FolderGit2 class="w-4 h-4 text-[#0db7b9] shrink-0" />
                    <span>{t.terminal.goToProjects}</span>
                </div>
                <kbd
                    class="text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded text-zinc-400"
                    >#projects</kbd
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="navigate"
                data-target="#contributions"
            >
                <div class="flex items-center gap-2.5">
                    <GitPullRequest class="w-4 h-4 text-purple-400 shrink-0" />
                    <span>{t.terminal.goToContributions}</span>
                </div>
                <kbd
                    class="text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded text-zinc-400"
                    >#contributions</kbd
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="navigate"
                data-target="#stack"
            >
                <div class="flex items-center gap-2.5">
                    <Cpu class="w-4 h-4 text-emerald-400 shrink-0" />
                    <span>{t.terminal.goToStack}</span>
                </div>
                <kbd
                    class="text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded text-zinc-400"
                    >#stack</kbd
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="navigate"
                data-target="#about"
            >
                <div class="flex items-center gap-2.5">
                    <User class="w-4 h-4 text-purple-300 shrink-0" />
                    <span>{t.terminal.goToAbout}</span>
                </div>
                <kbd
                    class="text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded text-zinc-400"
                    >#about</kbd
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="navigate"
                data-target="#contact"
            >
                <div class="flex items-center gap-2.5">
                    <Mail class="w-4 h-4 text-[#0db7b9] shrink-0" />
                    <span>{t.terminal.goToContact}</span>
                </div>
                <kbd
                    class="text-[10px] font-mono bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded text-zinc-400"
                    >#contact</kbd
                >
            </button>

            <div
                class="px-3 pt-3 pb-1 text-[11px] font-semibold uppercase tracking-wider text-zinc-400"
            >
                {t.terminal.actions}
            </div>

            <!--email_off-->
            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="copy-email"
            >
                <div class="flex items-center gap-2.5">
                    <Mail class="w-4 h-4 text-amber-400 shrink-0" />
                    <span class="copy-email-text">{t.terminal.copyEmail}</span>
                </div>
                <span class="text-[11px] font-mono text-zinc-400"
                    >hi@gefy.dev</span
                >
            </button>
            <!--/email_off-->

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="switch-lang"
                data-target-lang={otherLang}
            >
                <div class="flex items-center gap-2.5">
                    <Globe class="w-4 h-4 text-[#0db7b9] shrink-0" />
                    <span>{t.terminal.switchLanguage}</span>
                </div>
                <span class="text-[11px] font-mono text-[#0db7b9] font-bold"
                    >{otherLang.toUpperCase()}</span
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="open-url"
                data-url="https://github.com/gefydev"
            >
                <div class="flex items-center gap-2.5">
                    <Github class="w-4 h-4 text-zinc-300 shrink-0" />
                    <span>{t.terminal.openGithub}</span>
                </div>
                <span class="text-[11px] font-mono text-zinc-400">@gefydev</span
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="open-url"
                data-url="https://linkedin.com/in/gefydev"
            >
                <div class="flex items-center gap-2.5">
                    <Linkedin class="w-4 h-4 text-[#0db7b9] shrink-0" />
                    <span>{t.terminal.openLinkedin}</span>
                </div>
                <span class="text-[11px] font-mono text-zinc-400"
                    >/in/gefydev</span
                >
            </button>

            <button
                type="button"
                class="terminal-item w-full flex items-center justify-between px-3 py-2.5 rounded-lg hover:bg-zinc-900 text-left text-zinc-300 hover:text-white transition-colors cursor-pointer"
                data-action="confetti"
            >
                <div class="flex items-center gap-2.5">
                    <Sparkles class="w-4 h-4 text-amber-400 shrink-0" />
                    <span>{t.terminal.triggerConfetti}</span>
                </div>
                <span class="text-[11px] text-amber-400">🎉</span>
            </button>
        </div>

        <div
            class="px-4 py-2.5 border-t border-zinc-800/80 bg-zinc-900/40 flex items-center justify-between text-xs text-zinc-400"
        >
            <span>{t.terminal.close}</span>
            <span class="font-mono text-[11px]"
                >[↵] {lang === "es" ? "Ejecutar" : "Select"}</span
            >
        </div>
    </div>

    <div
        id="email-copied-toast"
        class="fixed bottom-6 right-6 hidden bg-emerald-950 border border-emerald-800 text-emerald-300 px-4 py-3 rounded-xl shadow-2xl flex items-center gap-2 text-xs font-semibold z-60"
    >
        <Check class="w-4 h-4" />
        <span>{t.terminal.emailCopiedNotice}</span>
    </div>
</div>

<script>
    let selectedIndex = 0;

    function getTerminalElements() {
        const modal = document.getElementById("terminal-modal");
        const card = document.getElementById("terminal-card");
        const input = document.getElementById(
            "terminal-search-input",
        ) as HTMLInputElement | null;
        const closeBtn = document.getElementById("close-terminal-btn");
        const list = document.getElementById("terminal-list");
        const items = list
            ? (Array.from(
                  list.querySelectorAll(".terminal-item"),
              ) as HTMLButtonElement[])
            : [];
        const toast = document.getElementById("email-copied-toast");

        return { modal, card, input, closeBtn, list, items, toast };
    }

    function openTerminal() {
        const { modal, card, input, items } = getTerminalElements();
        if (!modal || !card || !input) return;

        modal.classList.remove("hidden");
        document.body.style.overflow = "hidden";
        input.value = "";
        selectedIndex = 0;
        filterItems("");
        updateSelection(0);

        requestAnimationFrame(() => {
            input.focus();
        });
    }

    function closeTerminal() {
        const { modal, input } = getTerminalElements();
        if (!modal) return;

        modal.classList.add("hidden");
        document.body.style.overflow = "";
        if (input) input.value = "";
    }

    function updateSelection(newIndex: number) {
        const { items } = getTerminalElements();
        const visibleItems = items.filter((i) => i.style.display !== "none");
        if (visibleItems.length === 0) return;

        selectedIndex = (newIndex + visibleItems.length) % visibleItems.length;

        visibleItems.forEach((item, idx) => {
            if (idx === selectedIndex) {
                item.classList.add("bg-zinc-800", "text-white");
                item.classList.remove("text-zinc-300");
                item.scrollIntoView({ block: "nearest" });
            } else {
                item.classList.remove("bg-zinc-800", "text-white");
                item.classList.add("text-zinc-300");
            }
        });
    }

    function filterItems(query: string) {
        const { items } = getTerminalElements();
        const q = query.toLowerCase().trim();

        items.forEach((item) => {
            const text = item.textContent?.toLowerCase() || "";
            const matches = text.includes(q);
            item.style.display = matches ? "flex" : "none";
        });

        const headers = document.querySelectorAll(
            "#terminal-list > div:not(.terminal-item)",
        );
        headers.forEach((h) => {
            (h as HTMLElement).style.display = q === "" ? "block" : "none";
        });

        selectedIndex = 0;
        updateSelection(0);
    }

    function showToast() {
        const { toast } = getTerminalElements();
        if (!toast) return;
        toast.classList.remove("hidden");
        setTimeout(() => {
            toast.classList.add("hidden");
        }, 3000);
    }

    function triggerModalConfetti(opts: Record<string, any>) {
        const fire = (confettiFn: Function) => {
            confettiFn(opts);
        };

        if ((window as any).confetti) {
            fire((window as any).confetti);
            return;
        }

        const script = document.createElement("script");
        script.src = "/scripts/confetti.min.js";
        script.async = true;
        script.onload = () => {
            if ((window as any).confetti) {
                fire((window as any).confetti);
            }
        };
        document.body.appendChild(script);
    }

    function initTerminal() {
        const { modal, card, input, closeBtn, items } = getTerminalElements();
        if (!modal || (modal as HTMLElement).dataset.bound) return;
        (modal as HTMLElement).dataset.bound = "true";

        window.addEventListener("open-terminal", openTerminal);

        closeBtn?.addEventListener("click", closeTerminal);

        modal.addEventListener("click", (e) => {
            if (e.target === modal) {
                closeTerminal();
            }
        });

        input?.addEventListener("input", (e) => {
            filterItems((e.target as HTMLInputElement).value);
        });

        items.forEach((item) => {
            item.addEventListener("mouseenter", () => {
                const visibleItems = items.filter(
                    (i) => i.style.display !== "none",
                );
                const idx = visibleItems.indexOf(item);
                if (idx !== -1) updateSelection(idx);
            });

            item.addEventListener("click", () => {
                const action = item.getAttribute("data-action");

                if (action === "navigate") {
                    const target = item.getAttribute("data-target");
                    if (target) {
                        closeTerminal();
                        const el = document.querySelector(target);
                        if (el) {
                            const prefersReducedMotion = window.matchMedia(
                                "(prefers-reduced-motion: reduce)",
                            ).matches;
                            el.scrollIntoView({
                                behavior: prefersReducedMotion
                                    ? "auto"
                                    : "smooth",
                            });
                        }
                    }
                } else if (action === "copy-email") {
                    if (navigator.clipboard) {
                        navigator.clipboard
                            .writeText("hi@gefy.dev")
                            .then(() => {
                                showToast();
                            })
                            .catch(() => {});
                    }
                    closeTerminal();
                } else if (action === "switch-lang") {
                    const targetLang = item.getAttribute("data-target-lang");
                    if (targetLang) {
                        closeTerminal();
                        window.location.href = `/${targetLang}`;
                    }
                } else if (action === "open-url") {
                    const url = item.getAttribute("data-url");
                    if (url) {
                        window.open(url, "_blank", "noopener,noreferrer");
                        closeTerminal();
                    }
                } else if (action === "confetti") {
                    closeTerminal();
                    triggerModalConfetti({
                        particleCount: 80,
                        spread: 70,
                        origin: { y: 0.6 },
                        colors: ["#0db7b9", "#735ed5", "#22d3ee", "#8b5cf6"],
                    });
                }
            });
        });
    }

    document.addEventListener("keydown", (e) => {
        const { modal, input, closeBtn } = getTerminalElements();
        const isHidden = modal?.classList.contains("hidden");

        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
            e.preventDefault();
            if (isHidden) {
                openTerminal();
            } else {
                closeTerminal();
            }
        } else if (e.key === "Escape" && !isHidden) {
            e.preventDefault();
            closeTerminal();
        } else if (!isHidden) {
            const { items, input, closeBtn } = getTerminalElements();
            const visibleItems = items.filter(
                (i) => i.style.display !== "none",
            );

            if (e.key === "ArrowDown") {
                e.preventDefault();
                updateSelection(selectedIndex + 1);
            } else if (e.key === "ArrowUp") {
                e.preventDefault();
                updateSelection(selectedIndex - 1);
            } else if (e.key === "Enter") {
                e.preventDefault();
                if (visibleItems[selectedIndex]) {
                    visibleItems[selectedIndex].click();
                }
            } else if (e.key === "Tab") {
                e.preventDefault();
                const focusable = [input, closeBtn, ...visibleItems].filter(
                    Boolean,
                ) as HTMLElement[];
                const currentIndex = focusable.indexOf(
                    document.activeElement as HTMLElement,
                );
                const nextIndex = e.shiftKey
                    ? (currentIndex - 1 + focusable.length) % focusable.length
                    : (currentIndex + 1) % focusable.length;
                focusable[nextIndex]?.focus();
            }
        }
    });

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initTerminal);
    } else {
        initTerminal();
    }
    document.addEventListener("astro:page-load", initTerminal);
</script>
