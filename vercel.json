{
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000, immutable"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=2592000, stale-while-revalidate=604800"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=3600"
        }
      ]
    },
    {
      "source": "/cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"GenaroFebboYapur-CV-EN.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noarchive"
        }
      ]
    },
    {
      "source": "/es/cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"GenaroFebboYapur-CV-ES.pdf\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=3600"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noarchive"
        }
      ]
    }
  ]
}
